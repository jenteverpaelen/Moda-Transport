---
/* =========================================================================
   HET RAAMWERK VAN MODA-SNELTRANSPORT.BE
   -------------------------------------------------------------------------
   Eén layout voor beide onderdelen van deze site: luchthavenvervoer en
   sneltransport. Het menu wisselt mee, de rest is gelijk.

   Het idee achter de vormgeving staat in DESIGN.md. Kort: de site rekent
   terug vanaf het vertrekuur van je vlucht, en ze is donker omdat de ritten
   waar het over gaat om vier uur 's ochtends vertrekken.
   ========================================================================= */
import instellingen from "../../public/content/settings.json";
import { MODA } from "../lib/moda.mjs";

const {
  titel,
  omschrijving,
  actief = "",
  deel = "luchthaven",
  /* Staat de bovenbalk boven een hero die zelf al donker is? Dan blijft ze
     doorzichtig tot je scrollt. */
  opHero = false,
  /* De vaste balk onderaan op gsm: welke twee knoppen daar staan. */
  balkKnop = { url: "/reserveren/", tekst: "Reserveer uw rit" },
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, MODA.vervoer).href;
const waLink = `https://wa.me/${instellingen.whatsapp_nummer}?text=${encodeURIComponent(instellingen.whatsapp_bericht)}`;

const menuLucht = [
  { url: "/diensten/",   tekst: "Diensten",   sleutel: "diensten" },
  { url: "/vloot/",      tekst: "Vloot",      sleutel: "vloot" },
  { url: "/prijs/",      tekst: "Tarieven",   sleutel: "prijs" },
  { url: "/reserveren/", tekst: "Reserveren", sleutel: "reserveren" },
];
const menuTransport = [
  { url: "/transport/",           tekst: "Transport",  sleutel: "transport" },
  { url: "/transport/diensten/",  tekst: "Diensten",   sleutel: "t-diensten" },
  { url: "/transport/wagenpark/", tekst: "Wagenpark",  sleutel: "t-wagenpark" },
  { url: "/transport/offerte/",   tekst: "Offerte",    sleutel: "t-offerte" },
];
const menu = deel === "transport" ? menuTransport : menuLucht;

const bedrijfsgegevens = {
  "@context": "https://schema.org",
  "@type": "TaxiService",
  "@id": "https://moda-sneltransport.be/#business",
  name: "Moda luchthavenvervoer",
  description: "Luchthavenvervoer vanuit Limburg naar Zaventem, Charleroi, Eindhoven, Düsseldorf en Schiphol. Vaste prijs vooraf, eigen Mercedes-wagens, vluchtopvolging.",
  url: MODA.vervoer + "/",
  telephone: instellingen.telefoon_link,
  email: instellingen.email,
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Beringersteenweg 14",
    postalCode: "3550", addressLocality: "Heusden-Zolder",
    addressRegion: "Limburg", addressCountry: "BE",
  },
  geo: { "@type": "GeoCoordinates", latitude: 51.0271799, longitude: 5.2654197 },
  areaServed: { "@type": "AdministrativeArea", name: "Limburg, België" },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    opens: "00:00", closes: "23:59",
  },
};
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A0C0E" />

  <title>{titel}</title>
  <meta name="description" content={omschrijving} />
  <link rel="canonical" href={paginaUrl} />
  <meta name="robots" content="index, follow" />

  <meta name="geo.region" content="BE-VLI" />
  <meta name="geo.placename" content="Heusden-Zolder" />
  <meta name="geo.position" content="51.0271799;5.2654197" />

  <meta property="og:site_name" content="Moda" />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={omschrijving} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="nl_BE" />
  <meta property="og:url" content={paginaUrl} />
  <meta property="og:image" content="https://moda-sneltransport.be/assets/images/logo-transport.png" />
  <meta name="twitter:card" content="summary_large_image" />

  <script is:inline>
    (function () {
      var page = location.origin + location.pathname;
      var c = document.querySelector('link[rel="canonical"]'); if (c) c.setAttribute("href", page);
      var o = document.querySelector('meta[property="og:url"]'); if (o) o.setAttribute("content", page);
    })();
  </script>

  <link rel="icon" type="image/png" href="/assets/images/logo-embleem.png" />

  <!-- Archivo in twee breedtes en Martian Mono voor de cijfers. Beide staan in
       deze repo: sneller, en het IP-adres van elke bezoeker gaat niet naar
       Google. -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/archivo-var.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/martian-mono-var.woff2" />
  <link rel="stylesheet" href="/assets/css/moda.css" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(bedrijfsgegevens)}></script>
</head>
<body>

<a href="#inhoud" class="enkel-lezer">Naar de inhoud</a>

<!-- De iconen. Getekend in één lijndikte, zodat er nergens een los
     unicode-pijltje voor icoon moet spelen. -->
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="ic-rechts" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6"/></symbol>
  <symbol id="ic-onder" viewBox="0 0 24 24"><path d="M12 4v15M6 13l6 6 6-6"/></symbol>
  <symbol id="ic-tel" viewBox="0 0 24 24"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z"/></symbol>
  <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="ic-vink" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></symbol>
  <symbol id="ic-kruis" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="ic-klok" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.2 2"/></symbol>
  <symbol id="ic-ster" viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45-4.7-4.6 6.5-.95z"/></symbol>
  <symbol id="ic-wa" viewBox="0 0 24 24"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.03 1.02-1.03 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.58-.34"/><path d="M12.05 21.78a9.87 9.87 0 0 1-5.03-1.37l-.36-.22-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26C2.17 6.44 6.6 2 12.05 2c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.89-9.88 9.89z"/></symbol>
</svg>

<!-- ===================== BOVENBALK ===================== -->
<header class:list={["kop-balk", !opHero && "is-vast"]} id="kopBalk">
  <div class="container kop-balk__inner">
    <a href={deel === "transport" ? "/transport/" : "/"} class="merk" aria-label="Moda, naar de startpagina">
      <img src="/assets/images/logo-transport-licht.png" alt="Moda" width="1600" height="533" />
    </a>

    <nav class="menu" id="menu" aria-label="Hoofdmenu">
      {menu.map((m) => (
        <a href={m.url} aria-current={actief === m.sleutel ? "page" : undefined}>{m.tekst}</a>
      ))}
      {deel === "transport"
        ? <a href="/">Luchthavenvervoer</a>
        : <a href="/transport/">Sneltransport</a>}
      <a class="menu__extra" href={`tel:${instellingen.telefoon_link}`}>{instellingen.telefoon_weergave}</a>
      <a class="menu__extra" href={MODA.travel + "/"}>Ook bij Moda: het reisbureau</a>
    </nav>

    <div class="kop-balk__rechts">
      <a class="kop-balk__tel" href={`tel:${instellingen.telefoon_link}`}>
        <svg class="ic" width="15" height="15" aria-hidden="true"><use href="#ic-tel"/></svg>
        {instellingen.telefoon_weergave}
      </a>
      <a class="knop knop--signaal knop--klein" href={balkKnop.url}>{balkKnop.tekst}</a>
      <button class="luik" id="luik" type="button" aria-label="Menu openen" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main id="inhoud">
  <slot />
</main>

<!-- ===================== VOET — het einde van de rit ===================== -->
<footer class="voet">
  <hr class="baan" />
  <div class="container">
    <div class="voet__kop">
      <h2>U bent er.</h2>
    </div>

    <div class="voet__raster">
      <div class="voet__merk">
        <img src="/assets/images/logo-transport-licht.png" alt="Moda" width="1600" height="533" />
        <p class="klein">
          Luchthavenvervoer en sneltransport uit Heusden-Zolder. Vaste prijs,
          eigen wagens, en iemand die opneemt als er iets verandert.
        </p>
      </div>

      <div>
        <h3>Bereikbaar</h3>
        <ul>
          <li><a href={`tel:${instellingen.telefoon_link}`}>{instellingen.telefoon_weergave}</a></li>
          <li><a href={`mailto:${instellingen.email}`}>{instellingen.email}</a></li>
          <li><a href={waLink} target="_blank" rel="noopener">WhatsApp</a></li>
          <li>{instellingen.adres}</li>
        </ul>
      </div>

      <div>
        <h3>Luchthavenvervoer</h3>
        <ul>
          <li><a href="/diensten/">Diensten</a></li>
          <li><a href="/vloot/">Onze vloot</a></li>
          <li><a href="/prijs/">Tarieven</a></li>
          <li><a href="/reserveren/">Reserveren</a></li>
        </ul>
      </div>

      <div>
        <h3>Ook bij Moda</h3>
        <ul>
          <li><a href="/transport/">Sneltransport</a></li>
          <li><a href={MODA.travel + "/"}>Het reisbureau</a></li>
          <li><a href={MODA.portaal + "/"}>Alle diensten</a></li>
        </ul>
      </div>
    </div>

    <div class="voet__onder">
      <p>© <span id="jaartal">2026</span> Moda · {instellingen.adres}</p>
      <p>Vergund bezoldigd vervoer · verzekerd</p>
    </div>
  </div>
</footer>

<!-- Vaste balk op gsm: de knop staat er altijd. -->
<div class="ritbalk" data-ritbalk>
  <a class="knop knop--stil knop--klein" href={`tel:${instellingen.telefoon_link}`} aria-label={`Bel ${instellingen.telefoon_weergave}`}>
    <svg class="ic" width="16" height="16" aria-hidden="true"><use href="#ic-tel"/></svg>
  </a>
  <a class="knop knop--signaal knop--klein" href={balkKnop.url}>{balkKnop.tekst}</a>
</div>

<script is:inline src="/assets/js/moda.js"></script>
</body>
</html>
