---
import { Image } from "astro:assets";
import Moda from "../layouts/Moda.astro";
import instellingen from "../../public/content/settings.json";
import prijzen from "../../public/content/prices.json";
import deurFoto from "../assets/luchthaven/deur.jpg";

const daarna = [
  { nr: "01", wat: "Wij kijken ernaar", u: "Meestal binnen het uur, en altijd door iemand van ons. Geen automatische bevestiging." },
  { nr: "02", wat: "Wij bevestigen het uur", u: "U krijgt het ophaaluur en het bedrag, telefonisch of per mail. Klopt er iets niet, dan passen we het aan." },
  { nr: "03", wat: "Wij staan er", u: "Op het afgesproken uur voor uw deur. Vanaf dan hoeft u nergens meer aan te denken." },
];
---
<Moda
  titel="Reserveren | Moda luchthavenvervoer"
  omschrijving="Reserveer uw rit naar de luchthaven. Geef uw vluchtuur door, wij rekenen het ophaaluur uit en bevestigen de vaste prijs."
  actief="reserveren">

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">Geef uw vluchtuur door. Wij doen de rest.</h1>
      <div class="pkop__onder">
        <p class="lood">
          U hoeft niet uit te rekenen hoe laat we moeten aanbellen — dat doen
          wij. Vul in wanneer u vertrekt en waarheen, en u krijgt het ophaaluur
          en de vaste prijs terug ter bevestiging.
        </p>
        <div class="pkop__cijfers">
          <div><span>Antwoord</span><span class="getal">meestal binnen het uur</span></div>
          <div><span>Vrijblijvend</span><span class="getal">tot u bevestigt</span></div>
          <div><span>Liever bellen</span><span class="getal">{instellingen.telefoon_weergave}</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="container aanvraag">
      <div class="aanvraag__zij toon">
        <h2 class="kop">Wat er daarna gebeurt</h2>
        <ul>
          {daarna.map((d) => (
            <li><b>{d.nr}</b> <span><strong>{d.wat}.</strong> {d.u}</span></li>
          ))}
        </ul>

        <h2 class="kop" style="margin-top:clamp(30px,4vw,44px)">Liever direct</h2>
        <ul>
          <li><b>Bellen</b> <a href={`tel:${instellingen.telefoon_link}`}>{instellingen.telefoon_weergave}</a></li>
          <li><b>Mailen</b> <a href={`mailto:${instellingen.email}`}>{instellingen.email}</a></li>
          <li><b>WhatsApp</b> <a href={`https://wa.me/${instellingen.whatsapp_nummer}?text=${encodeURIComponent(instellingen.whatsapp_bericht)}`} target="_blank" rel="noopener">Stuur een bericht</a></li>
          <li><b>Adres</b> <span>{instellingen.adres}</span></li>
        </ul>
      </div>

      <form class="formulier toon" data-formulier="rit" novalidate>
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div class="veldrij">
          <div class="fveld">
            <label for="naam">Naam</label>
            <input type="text" id="naam" name="naam" placeholder="Uw naam" required autocomplete="name" />
          </div>
          <div class="fveld">
            <label for="telefoon">Telefoon</label>
            <input type="tel" id="telefoon" name="telefoon" placeholder="0470 00 00 00" required autocomplete="tel" />
          </div>
        </div>

        <div class="fveld">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="u@voorbeeld.be" required autocomplete="email" />
        </div>

        <div class="fveld">
          <label for="ophaaladres">Waar halen we u op</label>
          <input type="text" id="ophaaladres" name="ophaaladres" placeholder="Straat, nummer en gemeente" required autocomplete="street-address" />
        </div>

        <div class="veldrij">
          <div class="fveld">
            <label for="luchthaven">Naar welke luchthaven</label>
            <select id="luchthaven" name="luchthaven" required>
              <option value="" disabled selected>Kies een luchthaven</option>
              {prijzen.luchthavens.map((l) => (<option value={l.value}>{l.label}</option>))}
            </select>
          </div>
          <div class="fveld">
            <label for="richting">Heen, of heen en terug</label>
            <select id="richting" name="richting">
              <option value="heen">Alleen heen</option>
              <option value="beide">Heen en terug</option>
              <option value="terug">Alleen terug (ophalen)</option>
            </select>
          </div>
        </div>

        <div class="veldrij">
          <div class="fveld">
            <label for="datum">Datum van vertrek</label>
            <input type="date" id="datum" name="datum" required />
          </div>
          <div class="fveld">
            <label for="vluchtuur">Uw vlucht vertrekt om</label>
            <input type="time" id="vluchtuur" name="vluchtuur" step="300" />
          </div>
        </div>

        <div class="veldrij">
          <div class="fveld">
            <label for="ophaaluur">Gewenst ophaaluur (mag leeg)</label>
            <input type="time" id="ophaaluur" name="ophaaluur" step="300" />
          </div>
          <div class="fveld">
            <label for="personen">Aantal personen</label>
            <input type="number" id="personen" name="personen" min="1" max="16" value="2" required />
          </div>
        </div>

        <div class="veldrij">
          <div class="fveld">
            <label for="vluchtnummer">Vluchtnummer (mag leeg)</label>
            <input type="text" id="vluchtnummer" name="vluchtnummer" placeholder="Bv. SN2853" />
          </div>
          <div class="fveld">
            <label for="koffers">Aantal grote koffers</label>
            <input type="number" id="koffers" name="koffers" min="0" max="16" placeholder="2" />
          </div>
        </div>

        <div class="fveld">
          <label for="opmerkingen">Opmerkingen (mag leeg)</label>
          <textarea id="opmerkingen" name="opmerkingen" rows="3" placeholder="Kinderzitje, tussenstop, meerdere ophaaladressen …"></textarea>
        </div>

        <button type="submit" class="knop knop--signaal knop--breed">
          Verstuur mijn aanvraag <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
        </button>
        <p class="fnoot" data-noot role="status">
          Vrijblijvend. Uw rit staat pas vast als wij hem bevestigd hebben.
        </p>
      </form>
    </div>
  </section>

  <section class="slot">
    <div class="slot__beeld" aria-hidden="true"><Image src={deurFoto} width={1800} alt="" /></div>
    <div class="container">
      <h2 class="reus">Moet het snel gaan? Bel gerust.</h2>
      <p class="slot__lead">
        Vertrekt u morgenvroeg en heeft u nog niets geregeld? Bel dan liever
        dan te mailen — dan weet u meteen of het lukt.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>
</Moda>
