---
import Transport from "../../layouts/Transport.astro";
---
<Transport
  titel="Offerte aanvragen | Moda Transport"
  omschrijving="Vraag vrijblijvend een prijs op maat voor uw transport. Bellen of WhatsAppen kan ook."
  actief="offerte">

  <section class="section section--alt" id="offerte">
    <div class="container booking">
      <div class="booking__intro reveal">
        <p class="section__eyebrow">Offerte of transport aanvragen</p>
        <h2 class="section__title">Klaar om te verzenden?</h2>
        <p class="section__lead">
          Vul kort in wat en waarheen, en wij bezorgen u snel een prijs op maat.
          Liever meteen bellen of WhatsAppen? Dat kan ook.
        </p>
        <ul class="booking__contactlist">
          <li><span>📞</span> <a href="tel:+3211243003">011 24 30 03</a></li>
          <li><span>✉️</span> <a href="mailto:info@moda-sneltransport.be">info@moda-sneltransport.be</a></li>
          <li><span>📍</span> <a href="https://www.google.com/maps/search/?api=1&amp;query=Beringersteenweg+14+3550+Heusden-Zolder" target="_blank" rel="noopener">Beringersteenweg 14, 3550 Heusden-Zolder</a></li>
        </ul>
        <div class="quickcontact">
          <a href="tel:+3211243003" class="btn btn--sm btn--primary">📞 Bel direct</a>
          <a href="https://wa.me/32000000000?text=Hallo%2C%20ik%20heb%20een%20transportvraag%20voor%20Moda%20Transport"
             class="btn btn--sm btn--wa" target="_blank" rel="noopener">
            <svg class="btn__wa" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#wa-icon"/></svg>
            WhatsApp
          </a>
        </div>
      </div>

      <form class="booking__form reveal" id="quoteForm" novalidate>
        <!-- Spam-val (onzichtbaar; enkel bots vinken dit aan) -->
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div class="field">
          <label for="name">Naam</label>
          <input type="text" id="name" name="name" placeholder="Uw naam of bedrijf" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Telefoon</label>
            <input type="tel" id="phone" name="phone" placeholder="+32 ..." required />
          </div>
          <div class="field">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="u@voorbeeld.be" required />
          </div>
        </div>
        <div class="field">
          <label for="goods">Wat wilt u vervoeren?</label>
          <input type="text" id="goods" name="goods" placeholder="Bv. 3 pallets, een koelzending, een spoedpakket ..." required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="pickup">Ophaaladres</label>
            <input type="text" id="pickup" name="pickup" placeholder="Straat, gemeente" required />
          </div>
          <div class="field">
            <label for="dropoff">Leveradres</label>
            <input type="text" id="dropoff" name="dropoff" placeholder="Straat, gemeente" required />
          </div>
        </div>
        <div class="field">
          <label for="date">Gewenste datum</label>
          <input type="date" id="date" name="date" />
        </div>
        <div class="field">
          <label for="notes">Opmerkingen (optioneel)</label>
          <textarea id="notes" name="notes" rows="3" placeholder="Gewicht, afmetingen, tijdstip, bijzonderheden ..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block">Vraag mijn offerte aan</button>
        <p class="booking__note" id="formNote" role="status"></p>
      </form>
    </div>
  </section>

</Transport>
