---
import { Image } from "astro:assets";
import Moda from "../../layouts/Moda.astro";
import instellingen from "../../../public/content/settings.json";
import koelFoto from "../../assets/transport/koelwagen.png";
import vrachtFoto from "../../assets/transport/vrachtwagen.jpg";

const diensten = [
  { wat: "Expresstransport", u: "Een zending die vandaag nog ter plaatse moet. Wij rijden rechtstreeks, zonder overslag onderweg, lokaal en internationaal.", detail: ["Rechtstreeks gereden","Geen overslag","Lokaal en internationaal"] },
  { wat: "Koeriersdienst", u: "Belangrijke documenten of kleine pakketten, snel en veilig van deur tot deur. Eén chauffeur van ophaling tot aflevering.", detail: ["Van deur tot deur","Eén chauffeur","Bewijs van levering"] },
  { wat: "Palletvervoer", u: "Van één pallet tot een volle lading van 33. Voor elk gewicht de juiste wagen, dus u betaalt niet voor ruimte die u niet gebruikt.", detail: ["1 tot 33 pallets","Juiste wagen per lading","Laadklep beschikbaar"] },
  { wat: "Koeltransport", u: "Temperatuurgevoelige goederen, stabiel gehouden over de hele rit. De koelwagen houdt alles tussen −26 en +26 °C.", detail: ["−26 tot +26 °C","Stabiel over de hele rit","Ook diepvries"] },
  { wat: "ADR en gevaarlijke goederen", u: "Gevaarlijke stoffen veilig vervoerd, met gecertificeerde chauffeurs en het juiste materiaal aan boord.", detail: ["ADR-gecertificeerd","Juist materiaal","Volgens de regels"] },
  { wat: "Opslag en overslag", u: "Even stockeren of overladen kan ook bij ons. Dat scheelt u het zoeken naar een tweede partij die het moet overnemen.", detail: ["Tijdelijke opslag","Overslag","In overleg"] },
];
---
<Moda
  titel="Diensten | Moda sneltransport"
  omschrijving="Expresstransport, koeriersdienst, palletvervoer, koeltransport, ADR en opslag. Eén partner voor al uw transport, vanuit Limburg."
  actief="t-diensten" deel="transport"
  balkKnop={{ url: "/transport/offerte/", tekst: "Vraag een offerte" }}>

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">Eén partner voor alles wat weg moet.</h1>
      <div class="pkop__onder">
        <p class="lood">
          Van een klein spoedpakket tot een volle vracht, gekoeld of gevaarlijk,
          binnenland of Europa. Wij zeggen liever wat wel kan dan wat niet kan.
        </p>
        <div class="pkop__cijfers">
          <div><span>Pallets in één rit</span><span class="getal">tot 33</span></div>
          <div><span>Koeltransport</span><span class="getal">−26 tot +26 °C</span></div>
          <div><span>Bereikbaar</span><span class="getal">24/7</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="container">
      <div class="trajecten">
        {diensten.map((d) => (
          <article class="traject toon">
            <div>
              <h2 class="traject__wat">{d.wat}</h2>
              <div class="plaatsen" style="margin-top:12px">
                {d.detail.map((x) => (<span class="plaats">{x}</span>))}
              </div>
            </div>
            <p class="traject__uitleg">{d.u}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blok blok--asfalt">
    <div class="container detail">
      <div class="detail__beeld toon"><Image src={koelFoto} width={900} alt="Koelwagen van Moda" /></div>
      <div class="toon">
        <h2 class="detail__naam">Koeltransport dat de hele rit koud blijft</h2>
        <p class="lood">
          Niet alleen bij vertrek, maar tot bij de klant. De koelwagen houdt
          alles stabiel tussen −26 en +26 °C, ook als de rit langer duurt dan
          gepland. Geef bij uw aanvraag door welke temperatuur de lading nodig
          heeft, dan zetten we de wagen goed.
        </p>
        <div class="slot__acties" style="margin-top:24px">
          <a class="knop knop--signaal" href="/transport/offerte/">
            Vraag een offerte <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="slot">
    <div class="slot__beeld" aria-hidden="true"><Image src={vrachtFoto} width={1800} alt="" /></div>
    <div class="container">
      <h2 class="reus">Een bijzondere lading? Vertel het gewoon.</h2>
      <p class="slot__lead">
        Ook als u niet zeker weet of het kan. We zoeken het uit en zeggen
        eerlijk of we het aankunnen.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href="/transport/offerte/">Vraag een offerte</a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>
</Moda>
