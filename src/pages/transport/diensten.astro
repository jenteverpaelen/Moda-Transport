---
import Transport from "../../layouts/Transport.astro";
---
<Transport
  titel="Diensten | Moda Transport"
  omschrijving="Expresstransport, koeriersdienst, palletvervoer, koeltransport, ADR en opslag. Eén partner voor al uw transport."
  actief="diensten">

  <section class="section" id="diensten">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Onze diensten</p>
        <h2 class="section__title">Eén partner voor <span class="text-accent">al uw transport</span></h2>
        <p class="section__lead">
          Bij transportfirma Moda staan wij bekend om onze persoonlijke service en oplossingsgericht
          denken. Van een klein spoedpakket tot een volle vracht: wij regelen het.
        </p>
      </div>

      <div class="cards">
        <article class="card reveal">
          <div class="card__icon">⚡</div>
          <h3>Expresstransport</h3>
          <p>Een pakket dat vandaag nog ter plaatse moet? Wij leveren razendsnel, lokaal en internationaal.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">📨</div>
          <h3>Koeriersdienst</h3>
          <p>Belangrijke documenten of kleine pakketten, snel en veilig van deur tot deur bezorgd.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">📦</div>
          <h3>Palletvervoer</h3>
          <p>Van 1 pallet tot volle ladingen. Wij hebben voor elk gewicht de juiste wagen.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">🧊</div>
          <h3>Koeltransport</h3>
          <p>Temperatuurgevoelige goederen? Onze koelwagen houdt alles stabiel tussen -26 en +26 °C.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">🌍</div>
          <h3>Nationaal &amp; internationaal</h3>
          <p>In heel België en heel Europa, inclusief Frankrijk. Betrouwbaar tot op de bestemming.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">⚠️</div>
          <h3>ADR / gevaarlijke goederen</h3>
          <p>Gevaarlijke stoffen veilig vervoerd, met gecertificeerde chauffeurs en het juiste materiaal.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">🏬</div>
          <h3>Opslag &amp; overslag</h3>
          <p>Even stockeren of overladen? Wij bieden ook oplossingen voor opslag en overslag.</p>
        </article>

        <article class="card reveal">
          <div class="card__icon">🤝</div>
          <h3>Oplossingen op maat</h3>
          <p>Een bijzondere lading of vraag? Wij denken met u mee en zoeken de beste aanpak.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="waarom">
    <div class="container waarom__grid">
      <div class="waarom__intro reveal">
        <p class="section__eyebrow">Waarom Moda Transport</p>
        <h2 class="section__title">Uw lading, onze zorg.</h2>
        <p class="section__lead">
          Van kleine spoedzending tot volle vracht: wij regelen het met persoonlijke service
          en steeds het juiste materiaal.
        </p>
        <a href="/transport/offerte/" class="btn btn--primary">Vraag een offerte</a>
      </div>

      <div class="features">
        <div class="feature reveal">
          <div class="feature__icon">🤝</div>
          <div>
            <h3>Persoonlijke service</h3>
            <p>Eén vast aanspreekpunt dat met u meedenkt, van aanvraag tot levering.</p>
          </div>
        </div>
        <div class="feature reveal">
          <div class="feature__icon">💡</div>
          <div>
            <h3>Oplossingsgericht</h3>
            <p>Voor elke lading de juiste wagen en de slimste aanpak.</p>
          </div>
        </div>
        <div class="feature reveal">
          <div class="feature__icon">🚛</div>
          <div>
            <h3>Gevarieerd wagenpark</h3>
            <p>Van bestelwagen tot vrachtwagen, standaard of gekoeld.</p>
          </div>
        </div>
        <div class="feature reveal">
          <div class="feature__icon">⏱️</div>
          <div>
            <h3>Betrouwbaar &amp; stipt</h3>
            <p>Uw zending vertrekt en komt aan precies zoals afgesproken.</p>
          </div>
        </div>
        <div class="feature reveal">
          <div class="feature__icon">🌙</div>
          <div>
            <h3>24/7 beschikbaar</h3>
            <p>Ook voor spoed, 's nachts en in het weekend.</p>
          </div>
        </div>
        <div class="feature reveal">
          <div class="feature__icon">🛡️</div>
          <div>
            <h3>ADR-gecertificeerd</h3>
            <p>Gevaarlijke goederen veilig en volgens de regels vervoerd.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Transport>
