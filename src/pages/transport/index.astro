---
import Transport from "../../layouts/Transport.astro";
---
<Transport
  titel="Moda Transport | Sneltransport &amp; koeriersdiensten Limburg"
  omschrijving="Sneltransport, koerier en vrachtvervoer vanuit Heusden-Zolder. Van 1 pallet tot volle vracht, 24/7 beschikbaar."
  actief="home"
  heeftHero={true}>

  <section class="hero" id="home">
    <div class="hero__media" aria-hidden="true">
      <div class="hero__img" style="background-image:url('/assets/images/transport/hero.jpg')"></div>
      <div class="hero__overlay"></div>
    </div>

    <div class="container hero__content">
      <p class="hero__eyebrow reveal">✦ Sneltransport &amp; koeriersdiensten</p>
      <h1 class="hero__title reveal">
        Razendsnel transport,<br />
        van pakket tot <span class="text-accent">volle vracht</span>.
      </h1>
      <p class="hero__sub reveal">
        Persoonlijke service en oplossingsgericht denken. Met een gevarieerd wagenpark,
        van bestelwagen tot vrachtwagen, vervoeren wij lokaal én internationaal.
        Snel, betrouwbaar en 24/7 beschikbaar.
      </p>

      <div class="hero__actions reveal">
        <a href="/transport/offerte/" class="btn btn--primary btn--lg">Vraag een offerte</a>
        <a href="tel:+3211243003" class="btn btn--ghost btn--lg">📞 Bel 011 24 30 03</a>
        <a href="https://wa.me/32000000000?text=Hallo%2C%20ik%20heb%20een%20vraag%20over%20transport%20met%20Moda%20Transport"
           class="btn btn--wa btn--lg" target="_blank" rel="noopener">
          <svg class="btn__wa" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#wa-icon"/></svg>
          Chat via WhatsApp
        </a>
      </div>

      <div class="hero__badges reveal">
        <span>Lokaal &amp; internationaal</span>
        <span class="dot"></span>
        <span>Van 1 pallet tot 33</span>
        <span class="dot"></span>
        <span>24/7 beschikbaar</span>
      </div>
    </div>

    <a href="/transport/diensten/" class="hero__scroll" aria-label="Scroll naar beneden">
      <span class="hero__mouse"></span>
    </a>
  </section>

  <section class="stats">
    <div class="container stats__grid">
      <div class="stat reveal">
        <span class="stat__num stat__num--text">24/7</span>
        <span class="stat__label">Altijd beschikbaar</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num" data-count="33">0</span>
        <span class="stat__label">Pallets in één rit</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num stat__num--text">Europa</span>
        <span class="stat__label">Lokaal &amp; internationaal</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num stat__num--text">ADR</span>
        <span class="stat__label">Gevaarlijke goederen</span>
      </div>
    </div>
  </section>

  <!-- ===================== WEGWIJZER ===================== -->
  <section class="section" id="ontdek">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Ontdek</p>
        <h2 class="section__title">Wat kunnen wij voor u <span class="text-accent">vervoeren?</span></h2>
      </div>
      <div class="cards">
        <a class="card reveal" href="/transport/diensten/">
          <div class="card__icon">📦</div>
          <h3>Onze diensten</h3>
          <p>Van spoedpakket en koerier tot palletvervoer, koeltransport en ADR.</p>
        </a>
        <a class="card reveal" href="/transport/wagenpark/">
          <div class="card__icon">🚚</div>
          <h3>Ons wagenpark</h3>
          <p>Van bestelwagen tot vrachtwagen, met foto's en alle afmetingen.</p>
        </a>
        <a class="card reveal" href="/transport/offerte/">
          <div class="card__icon">📝</div>
          <h3>Offerte aanvragen</h3>
          <p>Vertel kort wat en waarheen, en u krijgt snel een prijs op maat.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container express__grid">
      <div class="express__intro reveal">
        <p class="section__eyebrow">Expresstransport</p>
        <h2 class="section__title">Moet uw pakket vandaag nog op bestemming zijn?</h2>
        <p class="section__lead">
          Voor spoedzendingen staan wij dag en nacht klaar. Eén telefoontje en wij vertrekken.
        </p>
        <a href="/transport/offerte/" class="btn btn--primary">Vraag een offerte</a>
      </div>

      <ul class="checklist reveal">
        <li>
          <span class="checklist__check" aria-hidden="true">✓</span>
          <span><strong>Supersnelle levering.</strong> Rechtstreeks van deur tot deur, zonder omwegen.</span>
        </li>
        <li>
          <span class="checklist__check" aria-hidden="true">✓</span>
          <span><strong>Lokaal en internationaal.</strong> In heel België en ver daarbuiten.</span>
        </li>
        <li>
          <span class="checklist__check" aria-hidden="true">✓</span>
          <span><strong>Betrouwbaar en altijd op tijd.</strong> Afspraak is afspraak.</span>
        </li>
        <li>
          <span class="checklist__check" aria-hidden="true">✓</span>
          <span><strong>24/7 beschikbaar voor noodgevallen.</strong> Ook 's nachts en in het weekend.</span>
        </li>
      </ul>
    </div>
  </section>

</Transport>
