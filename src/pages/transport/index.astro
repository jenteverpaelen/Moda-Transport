---
import { Image } from "astro:assets";
import Moda from "../../layouts/Moda.astro";
import instellingen from "../../../public/content/settings.json";
import heroFoto from "../../assets/transport/hero.jpg";
import sprinterFoto from "../../assets/transport/sprinter.jpg";
import vrachtFoto from "../../assets/transport/vrachtwagen.jpg";

/* Ook hier is een dienst een traject van A naar B, niet een kaartje met een
   icoontje erop. */
const trajecten = [
  { van: "Uw magazijn", naar: "Vandaag ter plaatse", wat: "Expresstransport",
    u: "Een zending die niet tot morgen kan wachten. Wij rijden rechtstreeks, zonder overslag, lokaal en internationaal." },
  { van: "Deur", naar: "Deur", wat: "Koeriersdienst",
    u: "Documenten of kleine pakketten die veilig en snel ter plaatse moeten. Eén chauffeur, van ophaling tot aflevering." },
  { van: "1 pallet", naar: "33 pallets", wat: "Palletvervoer",
    u: "Van één pallet tot een volle vracht. Voor elk gewicht de juiste wagen, dus u betaalt geen vrachtwagen voor een halve lading." },
  { van: "−26 °C", naar: "+26 °C", wat: "Koeltransport",
    u: "Temperatuurgevoelige goederen, stabiel gehouden over de hele rit. De koelwagen houdt alles tussen −26 en +26 °C." },
  { van: "België", naar: "Heel Europa", wat: "Nationaal en internationaal",
    u: "In heel België en heel Europa, Frankrijk inbegrepen. Betrouwbaar tot op de bestemming, met één aanspreekpunt hier." },
  { van: "ADR-lading", naar: "Veilig ter plaatse", wat: "Gevaarlijke goederen",
    u: "ADR-gecertificeerde chauffeurs en het juiste materiaal. Gevaarlijke stoffen vervoerd volgens de regels, zonder omweg." },
];

const waarom = [
  { t: "Eén aanspreekpunt", u: "Dezelfde persoon van aanvraag tot levering. U hoeft uw verhaal niet twee keer te doen." },
  { t: "Oplossingsgericht", u: "Een bijzondere lading of een krap uur? We zeggen wat wel kan, in plaats van wat niet kan." },
  { t: "Gevarieerd wagenpark", u: "Van bestelwagen tot vrachtwagen, standaard of gekoeld. Voor elke lading de juiste wagen." },
  { t: "Stipt", u: "Uw zending vertrekt en komt aan zoals afgesproken. Loopt er iets mis, dan hoort u het van ons eerst." },
  { t: "24/7 bereikbaar", u: "Ook voor spoed, 's nachts en in het weekend. Er neemt iemand op." },
  { t: "Opslag en overslag", u: "Even stockeren of overladen kan ook. Dat scheelt u een tweede partij zoeken." },
];
---
<Moda
  titel="Moda sneltransport | Koerier en vrachtvervoer vanuit Limburg"
  omschrijving="Sneltransport, koerier en vrachtvervoer vanuit Heusden-Zolder. Van één pallet tot volle vracht, gekoeld of ADR, nationaal en internationaal. 24/7 bereikbaar."
  actief="transport" deel="transport" opHero={true}
  balkKnop={{ url: "/transport/offerte/", tekst: "Vraag een offerte" }}>

  <section class="hero" id="hero">
    <div class="hero__doek" aria-hidden="true">
      <div class="hero__laag hero__laag--dag"><Image src={heroFoto} alt="" width={1800} loading="eager" fetchpriority="high" /></div>
    </div>
    <div class="container">
      <h1 class="reus" style="max-width:16ch">Vandaag besteld. Vandaag ter plaatse.</h1>
      <p class="lood" style="margin-top:22px; max-width:52ch">
        Sneltransport vanuit Heusden-Zolder, van één pakket tot een volle
        vracht. Rechtstreeks gereden, zonder overslag, met één aanspreekpunt
        dat u kunt bellen zolang de zending onderweg is.
      </p>
      <div class="slot__acties" style="margin-top:clamp(24px,3vw,36px)">
        <a class="knop knop--signaal" href="/transport/offerte/">
          Vraag een offerte <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
        </a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>

  <hr class="baan" />

  <section class="blok">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Wat wij rijden</h2>
        <p class="sectiekop__noot">Elke dienst is een traject: waar het vertrekt en waar het aankomt.</p>
      </div>
      <div class="trajecten">
        {trajecten.map((t) => (
          <article class="traject toon">
            <div class="traject__weg">
              <span class="traject__punt">{t.van}</span>
              <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
              <span class="traject__punt traject__punt--doel">{t.naar}</span>
            </div>
            <div>
              <h3 class="traject__wat">{t.wat}</h3>
              <p class="traject__uitleg">{t.u}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blok blok--asfalt">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Waarom bedrijven bij ons blijven</h2>
        <p class="sectiekop__noot">Zes dingen die elke week terugkomen in de gesprekken.</p>
      </div>
      <div class="punten toon">
        {waarom.map((w) => (<article class="punt"><h3>{w.t}</h3><p>{w.u}</p></article>))}
      </div>
    </div>
  </section>

  <section class="blok">
    <div class="container detail">
      <div class="detail__beeld toon"><Image src={sprinterFoto} width={900} alt="Mercedes Sprinter van Moda" /></div>
      <div class="toon">
        <h2 class="detail__naam">Voor elke lading de juiste wagen</h2>
        <p class="lood">
          Van bestelwagen tot vrachtwagen met laadklep, standaard of gekoeld.
          Dat betekent dat u geen vrachtwagen betaalt voor een halve lading, en
          niet moet wachten tot er toevallig iets past.
        </p>
        <div class="slot__acties" style="margin-top:24px">
          <a class="knop knop--stil" href="/transport/wagenpark/">
            Bekijk het wagenpark <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="slot">
    <div class="slot__beeld" aria-hidden="true"><Image src={vrachtFoto} width={1800} alt="" /></div>
    <div class="container">
      <h2 class="reus">Zeg wat er weg moet en wanneer.</h2>
      <p class="slot__lead">
        U krijgt een prijs terug, meestal dezelfde werkdag. Spoed? Bel dan
        liever — dan weet u meteen of het lukt.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href="/transport/offerte/">Vraag een offerte</a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>
</Moda>
