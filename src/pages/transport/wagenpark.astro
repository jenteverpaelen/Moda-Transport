---
import Transport from "../../layouts/Transport.astro";
---
<Transport
  titel="Wagenpark | Moda Transport"
  omschrijving="Vito, Sprinter, meubelbak, koelwagen, remorque en vrachtwagen. Met foto\u0027s van binnen en buiten, en alle afmetingen."
  actief="wagenpark">

  <section class="section section--alt" id="wagenpark">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Ons wagenpark</p>
        <h2 class="section__title">Voor elke lading <span class="text-accent">de juiste wagen</span></h2>
        <p class="section__lead">
          Van compacte bestelwagen tot volledige vrachtwagen. Zo vervoeren wij elk volume,
          elk gewicht en elke temperatuur.
        </p>
      </div>

      <div class="fleet">
        <article class="fleet-card reveal">
          <div class="fleet-card__img fleet-card__img--contain"><img src="/assets/images/transport/vito.png" alt="Moda Transport Vito bestelwagen" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Vito</h3><span class="fleet-card__tag">Colli's of 1 pallet</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 500 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">1,50 × 1,40 × 1,10 m</span></li>
              <li><span class="k">Europaletten</span><span class="v">1</span></li>
            </ul>
            <p class="fleet-card__desc">Ideaal voor colli's of één pallet, tot 600 kg.</p>
            <div class="fleet-card__fotos" data-wagen="Vito" data-fotos="/assets/images/transport/galerij/vito-1.jpg|/assets/images/transport/galerij/vito-2.jpg|/assets/images/transport/galerij/vito-3.jpg|/assets/images/transport/galerij/vito-4.jpg|/assets/images/transport/galerij/vito-5.jpg">
              <button type="button" class="fleet-thumb" data-i="0" aria-label="Foto 1 van de Vito bekijken"><img src="/assets/images/transport/galerij/vito-1.jpg" alt="Vito bestelwagen, foto 1" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="1" aria-label="Foto 2 van de Vito bekijken"><img src="/assets/images/transport/galerij/vito-2.jpg" alt="Vito bestelwagen, foto 2" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="2" aria-label="Foto 3 van de Vito bekijken"><img src="/assets/images/transport/galerij/vito-3.jpg" alt="Vito bestelwagen, foto 3" loading="lazy" /></button>
              <button type="button" class="fleet-thumb fleet-thumb--meer" data-i="3" aria-label="Bekijk alle 5 foto's van de Vito"><img src="/assets/images/transport/galerij/vito-4.jpg" alt="" loading="lazy" /><span>+1</span></button>
            </div>
          </div>
        </article>

        <article class="fleet-card reveal">
          <div class="fleet-card__img"><img src="/assets/images/transport/sprinter.jpg" alt="Moda Transport Mercedes Sprinter" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Sprinter</h3><span class="fleet-card__tag">Zijkant laden/lossen</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 1.100 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">4,30 × 1,70 × 1,90 m</span></li>
              <li><span class="k">Europaletten</span><span class="v">6</span></li>
            </ul>
            <p class="fleet-card__desc">Tot 6 pallets. Laden en lossen kan ook langs de zijkant, met spanriemen en zijbindingen.</p>
            <div class="fleet-card__fotos" data-wagen="Sprinter" data-fotos="/assets/images/transport/galerij/sprinter-1.jpg|/assets/images/transport/galerij/sprinter-2.jpg|/assets/images/transport/galerij/sprinter-3.jpg|/assets/images/transport/galerij/sprinter-4.jpg|/assets/images/transport/galerij/sprinter-5.jpg|/assets/images/transport/galerij/sprinter-6.jpg|/assets/images/transport/galerij/sprinter-7.jpg">
              <button type="button" class="fleet-thumb" data-i="0" aria-label="Foto 1 van de Sprinter bekijken"><img src="/assets/images/transport/galerij/sprinter-1.jpg" alt="Mercedes Sprinter, foto 1" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="1" aria-label="Foto 2 van de Sprinter bekijken"><img src="/assets/images/transport/galerij/sprinter-2.jpg" alt="Mercedes Sprinter, foto 2" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="2" aria-label="Foto 3 van de Sprinter bekijken"><img src="/assets/images/transport/galerij/sprinter-3.jpg" alt="Mercedes Sprinter, foto 3" loading="lazy" /></button>
              <button type="button" class="fleet-thumb fleet-thumb--meer" data-i="3" aria-label="Bekijk alle 7 foto's van de Sprinter"><img src="/assets/images/transport/galerij/sprinter-4.jpg" alt="" loading="lazy" /><span>+3</span></button>
            </div>
          </div>
        </article>

        <article class="fleet-card reveal">
          <div class="fleet-card__img"><img src="/assets/images/transport/meubelbak.jpg" alt="Moda Transport meubelbak met laadklep" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Meubelbak</h3><span class="fleet-card__tag">Met laadklep</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 850 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">4,30 × 2,10 × 2,30 m</span></li>
              <li><span class="k">Europaletten</span><span class="v">9 + laadklep</span></li>
            </ul>
            <p class="fleet-card__desc">Wagen met laadklep, dus laden en lossen zonder heftruck. Ideaal voor lichte pallets of karren.</p>
            <div class="fleet-card__fotos" data-wagen="Meubelbak" data-fotos="/assets/images/transport/galerij/meubelbak-1.jpg|/assets/images/transport/galerij/meubelbak-2.jpg|/assets/images/transport/galerij/meubelbak-3.jpg|/assets/images/transport/galerij/meubelbak-4.jpg|/assets/images/transport/galerij/meubelbak-5.jpg|/assets/images/transport/galerij/meubelbak-6.jpg|/assets/images/transport/galerij/meubelbak-7.jpg|/assets/images/transport/galerij/meubelbak-8.jpg|/assets/images/transport/galerij/meubelbak-9.jpg|/assets/images/transport/galerij/meubelbak-10.jpg|/assets/images/transport/galerij/meubelbak-11.jpg|/assets/images/transport/galerij/meubelbak-12.jpg">
              <button type="button" class="fleet-thumb" data-i="0" aria-label="Foto 1 van de Meubelbak bekijken"><img src="/assets/images/transport/galerij/meubelbak-1.jpg" alt="meubelbak met laadklep, foto 1" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="1" aria-label="Foto 2 van de Meubelbak bekijken"><img src="/assets/images/transport/galerij/meubelbak-2.jpg" alt="meubelbak met laadklep, foto 2" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="2" aria-label="Foto 3 van de Meubelbak bekijken"><img src="/assets/images/transport/galerij/meubelbak-3.jpg" alt="meubelbak met laadklep, foto 3" loading="lazy" /></button>
              <button type="button" class="fleet-thumb fleet-thumb--meer" data-i="3" aria-label="Bekijk alle 12 foto's van de Meubelbak"><img src="/assets/images/transport/galerij/meubelbak-4.jpg" alt="" loading="lazy" /><span>+8</span></button>
            </div>
          </div>
        </article>

        <article class="fleet-card reveal">
          <div class="fleet-card__img fleet-card__img--contain"><img src="/assets/images/transport/koelwagen.png" alt="Moda Transport koelwagen" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Koelwagen</h3><span class="fleet-card__tag">Temperatuurgeregeld</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 700 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">4,00 × 2,00 × 1,90 m</span></li>
              <li><span class="k">Temperatuur</span><span class="v">-26 tot +26 °C</span></li>
            </ul>
            <p class="fleet-card__desc">Tot 8 pallets met stabiele temperatuurcontrole. Geschikt voor voeding en temperatuurgevoelige producten.</p>
          </div>
        </article>

        <article class="fleet-card reveal">
          <div class="fleet-card__img"><img src="/assets/images/transport/remorque.jpg" alt="Moda Transport remorque / aanhangwagen" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Remorque</h3><span class="fleet-card__tag">Grotere ladingen</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 4.250 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">5,00 × 1,80 × 2,00 m</span></li>
              <li><span class="k">Europaletten</span><span class="v">15</span></li>
            </ul>
            <p class="fleet-card__desc">Voor grotere ladingen tot 4.250 kg, tot 15 pallets.</p>
            <div class="fleet-card__fotos" data-wagen="Remorque" data-fotos="/assets/images/transport/galerij/remorque-1.jpg|/assets/images/transport/galerij/remorque-2.jpg|/assets/images/transport/galerij/remorque-3.jpg">
              <button type="button" class="fleet-thumb" data-i="0" aria-label="Foto 1 van de Remorque bekijken"><img src="/assets/images/transport/galerij/remorque-1.jpg" alt="remorque met oplegger, foto 1" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="1" aria-label="Foto 2 van de Remorque bekijken"><img src="/assets/images/transport/galerij/remorque-2.jpg" alt="remorque met oplegger, foto 2" loading="lazy" /></button>
              <button type="button" class="fleet-thumb" data-i="2" aria-label="Foto 3 van de Remorque bekijken"><img src="/assets/images/transport/galerij/remorque-3.jpg" alt="remorque met oplegger, foto 3" loading="lazy" /></button>
            </div>
          </div>
        </article>

        <article class="fleet-card reveal">
          <div class="fleet-card__img"><img src="/assets/images/transport/vrachtwagen.jpg" alt="Moda Transport vrachtwagen voor heel Europa" loading="lazy" /></div>
          <div class="fleet-card__body">
            <div class="fleet-card__head"><h3>Vrachtwagen</h3><span class="fleet-card__tag">Heel Europa</span></div>
            <ul class="fleet-card__specs">
              <li><span class="k">Laadvermogen</span><span class="v">tot 25.000 kg</span></li>
              <li><span class="k">Afmetingen L×B×H</span><span class="v">13,20 × 2,50 × 2,60 m</span></li>
              <li><span class="k">Europaletten</span><span class="v">33</span></li>
            </ul>
            <p class="fleet-card__desc">Voor volle ladingen tot 33 pallets. Heel Europa, inclusief Frankrijk. Tautliner en boxtrailers.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="vloot">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">In beeld</p>
        <h2 class="section__title">Onze <span class="text-accent">vloot</span> aan het werk</h2>
        <p class="section__lead">
          Een greep uit ons wagenpark, van bestelwagen en bakwagen tot trekker met oplegger.
        </p>
      </div>

      <div class="gallery">
        <figure class="gallery__item gallery__item--feature reveal">
          <img src="/assets/images/transport/gallery-1.jpg" alt="Bakwagen en bestelwagen van Moda Transport" />
          <figcaption>Van klein tot groot transport</figcaption>
        </figure>
        <figure class="gallery__item gallery__item--wide reveal">
          <img src="/assets/images/transport/vrachtwagen.jpg" alt="Vrachtwagen met oplegger van Moda Transport" loading="lazy" />
          <figcaption>Vrachtwagen voor heel Europa</figcaption>
        </figure>
        <figure class="gallery__item reveal">
          <img src="/assets/images/transport/gallery-2.jpg" alt="Mercedes Sprinter van Moda Transport" loading="lazy" />
          <figcaption>Onze Sprinters</figcaption>
        </figure>
        <figure class="gallery__item reveal">
          <img src="/assets/images/transport/gallery-3.jpg" alt="Bakwagen van Moda Transport" loading="lazy" />
          <figcaption>Bakwagens met laadklep</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== FOTOVENSTER (wagenpark) ===================== -->
  <!-- Leeg skelet; wordt door transport.js gevuld bij een klik op een foto. -->
  <div class="fotobox" id="fotobox" aria-hidden="true">
    <div class="fotobox__achtergrond" data-sluit></div>
    <div class="fotobox__paneel" role="dialog" aria-modal="true" aria-labelledby="fotoboxTitel">
      <button class="fotobox__sluit" type="button" data-sluit aria-label="Venster sluiten">&times;</button>
      <button class="fotobox__nav fotobox__nav--vorige" type="button" data-stap="-1" aria-label="Vorige foto">&#8249;</button>
      <img class="fotobox__foto" id="fotoboxFoto" src="" alt="" />
      <button class="fotobox__nav fotobox__nav--volgende" type="button" data-stap="1" aria-label="Volgende foto">&#8250;</button>
      <p class="fotobox__bijschrift"><span id="fotoboxTitel"></span> <span class="fotobox__teller" id="fotoboxTeller"></span></p>
    </div>
  </div>

</Transport>
