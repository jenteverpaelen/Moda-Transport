---
import { Image } from "astro:assets";
import Moda from "../../layouts/Moda.astro";
import instellingen from "../../../public/content/settings.json";
import vitoFoto from "../../assets/transport/vito.png";
import sprinterFoto from "../../assets/transport/sprinter.jpg";
import meubelFoto from "../../assets/transport/meubelbak.jpg";
import koelFoto from "../../assets/transport/koelwagen.png";
import vrachtFoto from "../../assets/transport/vrachtwagen.jpg";

const wagens = [
  { naam: "Vito", foto: vitoFoto, alt: "Bestelwagen Mercedes Vito van Moda",
    u: "De kleinste van het park en vaak de snelste keuze. Voor documenten, pakketten en kleine spoedzendingen die rechtstreeks de baan op moeten.",
    specs: [["Type","bestelwagen"],["Geschikt voor","pakketten en documenten"],["Laadklep","nee"]] },
  { naam: "Sprinter", foto: sprinterFoto, alt: "Mercedes Sprinter van Moda",
    u: "De werkpaard van het park. Genoeg volume voor enkele pallets, en klein genoeg om vlot in een stadscentrum te geraken.",
    specs: [["Type","grote bestelwagen"],["Geschikt voor","enkele pallets"],["Laadklep","op aanvraag"]] },
  { naam: "Meubelbak met laadklep", foto: meubelFoto, alt: "Meubelbak met laadklep",
    u: "Voor volumineuze of kwetsbare ladingen die niet gestapeld kunnen worden. De laadklep scheelt een heftruck op de losplaats.",
    specs: [["Type","gesloten bak"],["Geschikt voor","volumineuze lading"],["Laadklep","ja"]] },
  { naam: "Koelwagen", foto: koelFoto, alt: "Koelwagen van Moda",
    u: "Temperatuurgevoelige goederen, stabiel tussen −26 en +26 °C over de hele rit. Ook voor diepvries.",
    specs: [["Type","koelwagen"],["Temperatuur","−26 tot +26 °C"],["Geschikt voor","vers en diepvries"]] },
  { naam: "Vrachtwagen", foto: vrachtFoto, alt: "Vrachtwagen van Moda",
    u: "Voor volle ladingen tot 33 pallets, nationaal en internationaal. Ook geschikt voor ADR-transport.",
    specs: [["Type","vrachtwagen"],["Capaciteit","tot 33 pallets"],["ADR","ja"]] },
];
---
<Moda
  titel="Wagenpark | Moda sneltransport"
  omschrijving="Van bestelwagen tot vrachtwagen, standaard of gekoeld. Voor elke lading de juiste wagen, tot 33 pallets en ADR-gecertificeerd."
  actief="t-wagenpark" deel="transport"
  balkKnop={{ url: "/transport/offerte/", tekst: "Vraag een offerte" }}>

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">Voor elke lading de juiste wagen.</h1>
      <div class="pkop__onder">
        <p class="lood">
          Vijf soorten wagens, van bestelwagen tot vrachtwagen met laadklep.
          Zo betaalt u nooit voor ruimte die u niet gebruikt, en hoeft u niet te
          wachten tot er toevallig iets past.
        </p>
        <div class="pkop__cijfers">
          <div><span>Soorten wagens</span><span class="getal">{wagens.length}</span></div>
          <div><span>Grootste lading</span><span class="getal">33 pallets</span></div>
          <div><span>Gekoeld</span><span class="getal">−26 tot +26 °C</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="container">
      {wagens.map((w, i) => (
        <article class={"detail toon" + (i % 2 === 1 ? " detail--gedraaid" : "")}>
          <div class="detail__beeld"><Image src={w.foto} width={1000} alt={w.alt} /></div>
          <div>
            <h2 class="detail__naam">{w.naam}</h2>
            <p class="lood">{w.u}</p>
            <ul class="wagen__specs" style="margin-top:20px">
              {w.specs.map(([a, b]) => (<li><span>{a}</span><span>{b}</span></li>))}
            </ul>
            <a class="knop knop--stil knop--klein" href="/transport/offerte/">
              Vraag een offerte <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="slot">
    <div class="container">
      <h2 class="reus">Niet zeker welke wagen u nodig heeft?</h2>
      <p class="slot__lead">
        Zeg wat er weg moet en hoe groot het is. Wij kiezen de wagen, dat is
        ons werk.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href="/transport/offerte/">Vraag een offerte</a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>
</Moda>
