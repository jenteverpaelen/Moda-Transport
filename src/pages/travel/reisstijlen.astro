---
import Travel from "../../layouts/Travel.astro";
---
<Travel
  titel="Reisstijlen | Moda Travel"
  omschrijving="Luxereizen, avontuurlijke reizen, familiereizen en romantische reizen. Wij stemmen elke reis af op wat jij zoekt."
  actief="reisstijlen">

  <section class="section section--alt" id="reisstijlen">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Reisstijlen</p>
        <h2 class="section__title">Welke reis past bij <span class="text-accent">jou?</span></h2>
        <p class="section__lead">
          Elke reiziger is anders. Vertel ons wat je zoekt en wij stemmen alles daarop af.
        </p>
      </div>

      <div class="stijlen">
        <article class="stijl reveal">
          <div class="stijl__icoon" aria-hidden="true">✨</div>
          <h3>Luxereizen</h3>
          <p>Comfort, kwaliteit en ervaringen die je niet zomaar ergens boekt.</p>
        </article>
        <article class="stijl reveal">
          <div class="stijl__icoon" aria-hidden="true">🧭</div>
          <h3>Avontuurlijke reizen</h3>
          <p>Voor wie verder wil gaan dan de gebaande paden en echt iets wil ontdekken.</p>
        </article>
        <article class="stijl reveal">
          <div class="stijl__icoon" aria-hidden="true">👨‍👩‍👧</div>
          <h3>Familiereizen</h3>
          <p>Onvergetelijke momenten voor jong en oud, met een tempo dat voor iedereen klopt.</p>
        </article>
        <article class="stijl reveal">
          <div class="stijl__icoon" aria-hidden="true">💞</div>
          <h3>Romantische reizen</h3>
          <p>Voor bijzondere momenten met z'n tweeën, van huwelijksreis tot verrassingsweekend.</p>
        </article>
      </div>
    </div>
  </section>

</Travel>
