---
import Travel from "../../layouts/Travel.astro";
import travel from "../../../public/content/travel-settings.json";
---
<Travel
  titel="Moda Travel | Reisbureau voor reizen zonder zorgen"
  omschrijving="Moda Travel stelt reizen op maat samen vanuit Heusden-Zolder. Onafhankelijk, persoonlijk en weg van het massatoerisme."
  actief="home"
  heeftHero={true}>

  <section class="reishero" id="home">
    <div class="container reishero__grid">
      <div class="reishero__tekst">
        <p class="reishero__eyebrow reveal">Reisbureau in Heusden-Zolder</p>
        <h1 class="reishero__titel reveal">Waar wil jij <em>naartoe?</em></h1>
        <p class="reishero__lead reveal">
          Wij stellen je reis van nul samen, afgestemd op wat jij zoekt. Geen vast
          pakket, geen massatoerisme, maar een route die klopt met jouw tempo,
          gezelschap en budget.
        </p>

        <div class="reishero__acties reveal">
          <a href="/travel/contact/" class="btn btn--primary btn--lg">Maak een afspraak</a>
          <a href="/travel/bestemmingen/" class="btn btn--ghost btn--lg">Bekijk bestemmingen</a>
        </div>

        <div class="reishero__cijfers reveal">
          <div class="reishero__cijfer">
            <strong><span class="stat__num" data-count="30" data-suffix="+">0</span></strong>
            <span>Jaar ervaring</span>
          </div>
          <div class="reishero__cijfer">
            <strong><span class="stat__num" data-count="1500" data-suffix="+">0</span></strong>
            <span>Tevreden reizigers</span>
          </div>
          <div class="reishero__cijfer">
            <strong><span class="stat__num" data-count="60" data-suffix="+">0</span></strong>
            <span>Bestemmingen</span>
          </div>
          <div class="reishero__cijfer">
            <strong><span class="stat__num" data-count="100" data-suffix="%">0</span></strong>
            <span>Aanbevolen</span>
          </div>
        </div>
      </div>

      <div class="reishero__beeld reveal">
        <div class="reishero__foto reishero__foto--groot">
          <img src="/assets/images/travel/hero.jpg" alt="Kustdorp aan de Middellandse Zee" />
        </div>
        <div class="reishero__foto reishero__foto--klein">
          <img src="/assets/images/travel/lapland.jpg" alt="Besneeuwd landschap in Lapland" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WEGWIJZER ===================== -->
  <section class="section" id="ontdek">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Ontdek</p>
        <h2 class="section__title">Waarmee kunnen we je <span class="text-accent">op weg helpen?</span></h2>
      </div>

      <div class="stijlen">
        <a class="stijl reveal" href="/travel/bestemmingen/">
          <div class="stijl__icoon" aria-hidden="true">🗺️</div>
          <h3>Bestemmingen</h3>
          <p>Van Lapland tot Thailand, en alles wat we op maat samenstellen.</p>
        </a>
        <a class="stijl reveal" href="/travel/reisstijlen/">
          <div class="stijl__icoon" aria-hidden="true">🧭</div>
          <h3>Reisstijlen</h3>
          <p>Luxe, avontuur, familie of romantisch: welke reis past bij jou?</p>
        </a>
        <a class="stijl reveal" href="/travel/over-ons/">
          <div class="stijl__icoon" aria-hidden="true">🧡</div>
          <h3>Over ons</h3>
          <p>Onafhankelijk reisbureau uit de streek, weg van het massatoerisme.</p>
        </a>
        <a class="stijl reveal" href="/travel/contact/">
          <div class="stijl__icoon" aria-hidden="true">📅</div>
          <h3>Maak een afspraak</h3>
          <p>Vertel wat je in gedachten hebt, wij bouwen de reis op.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container section__head reveal" style="margin-bottom:0">
      <p class="section__eyebrow">Klaar voor vertrek?</p>
      <h2 class="section__title">Waar wil jij naartoe?</h2>
      <p class="section__lead">
        Vertel ons je droombestemming of laat je inspireren. Wij stellen een reis op maat
        samen en bezorgen je een voorstel, helemaal vrijblijvend.
      </p>
      <div class="hero__actions" style="justify-content:center">
        <a href="/travel/contact/" class="btn btn--primary btn--lg">Vraag een reisvoorstel</a>
        <a href={`https://wa.me/${travel.whatsapp_nummer}?text=${encodeURIComponent("Hallo, ik wil graag een reisvoorstel van Moda Travel")}`}
           class="btn btn--wa btn--lg" target="_blank" rel="noopener">
          <svg class="btn__wa" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#wa-icon"/></svg>
          Chat via WhatsApp
        </a>
      </div>
    </div>
  </section>

</Travel>
