---
import Travel from "../../../layouts/Travel.astro";
import { leesReis, maakSlug } from "../../../lib/reis.mjs";
/* Het reisbestand wordt hier meteen mee ingelezen tijdens het bouwen. Bewust een
   gewone import en geen bestand van schijf lezen: zo werkt het ook wanneer de
   bouwstap in een afgeschermde omgeving draait, zoals bij Cloudflare. */
import reisbestand from "../../../../public/content/travel-posts.json";

/* Voor elke reis in public/content/travel-posts.json wordt hier tijdens het
   bouwen een eigen pagina gemaakt, met een net adres zoals /travel/reizen/bon-bini/. */
export async function getStaticPaths() {
  return reisbestand.posts.map((post, i) => {
    const reis = leesReis(post.caption);
    return {
      params: { slug: maakSlug(reis.titel, i) },
      props: { reis, fotos: post.images || [], instagram: post.link },
    };
  });
}

const { reis, fotos, instagram } = Astro.props;
const kenmerken = [
  { icoon: "💶", label: reis.prijs, extra: reis.prijsnoot },
  { icoon: "📅", label: reis.vertrek ? "Vertrek " + reis.vertrek : "", extra: "" },
  { icoon: "🌙", label: reis.duur, extra: "" },
  { icoon: "✈️", label: reis.luchthaven ? "Vanuit " + reis.luchthaven : "", extra: "" },
].filter((k) => k.label);
const alinea = (reis.omschrijving || "").split("\n").map((r) => r.trim()).filter(Boolean);
const slug = maakSlug(reis.titel, 0);
---
<Travel
  titel={`${reis.titel} | Moda Travel`}
  omschrijving={reis.samenvatting || `Reis naar ${reis.bestemming || "je droombestemming"} met Moda Travel.`}
  actief="bestemmingen">

  <!-- ===================== REIS IN BEELD ===================== -->
  <section class="section reisdetail" id="reis">
    <div class="container">
      <a class="reisdetail__terug" href="/travel/bestemmingen/">← Alle bestemmingen</a>

      <div class="reisdetail__kop">
        <h1 class="reisdetail__titel">{reis.titel}</h1>
        {reis.samenvatting && <p class="reisdetail__sub">{reis.samenvatting}</p>}
      </div>

      <div class="reisdetail__hoofdfoto">
        <img src={fotos[0]} alt={reis.samenvatting || reis.titel} />
      </div>

      {kenmerken.length > 0 && (
        <div class="reisdetail__kenmerken">
          {kenmerken.map((k) => (
            <div class="reisdetail__kenmerk">
              <span class="reisdetail__icoon" aria-hidden="true">{k.icoon}</span>
              <span>
                <strong>{k.label}</strong>
                {k.extra && <em>{k.extra}</em>}
              </span>
            </div>
          ))}
        </div>
      )}

      <div class="reisdetail__body">
        <div class="reisdetail__tekst">
          <h2>Over deze reis</h2>
          {alinea.map((r) => <p>{r}</p>)}
          {alinea.length === 0 && <p>Vraag ons gerust naar de volledige details van deze reis.</p>}
        </div>

        <aside class="reisdetail__kaart">
          <h3>Interesse in deze reis?</h3>
          <p>Wij stemmen alles af op jouw wensen: data, verblijf en vervoer naar de luchthaven.</p>
          <a class="btn btn--primary btn--block" href={`/travel/contact/?reis=${slug}`}>Vraag deze reis aan</a>
          <a class="btn btn--ghost btn--block" href="tel:+3211243003">📞 011 24 30 03</a>
          {instagram && (
            <a class="reisdetail__insta" href={instagram} target="_blank" rel="noopener">Bekijk op Instagram</a>
          )}
        </aside>
      </div>

      {fotos.length > 1 && (
        <div class="reisdetail__fotos">
          <h2>In beeld</h2>
          <div class="reisdetail__raster">
            {fotos.map((f, i) => (
              <button type="button" class="reisfoto" data-i={i} aria-label={`Foto ${i + 1} groter bekijken`}>
                <img src={f} alt={`${reis.titel}, foto ${i + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Fotovenster voor de galerij van deze reis -->
  <div class="fotobox" id="fotobox" aria-hidden="true" data-fotos={fotos.join("|")}>
    <div class="fotobox__achtergrond" data-sluit></div>
    <div class="fotobox__paneel" role="dialog" aria-modal="true" aria-label="Foto van de reis">
      <button class="fotobox__sluit" type="button" data-sluit aria-label="Venster sluiten">&times;</button>
      <button class="fotobox__nav fotobox__nav--vorige" type="button" data-stap="-1" aria-label="Vorige foto">&#8249;</button>
      <img class="fotobox__foto" id="fotoboxFoto" src="" alt="" />
      <button class="fotobox__nav fotobox__nav--volgende" type="button" data-stap="1" aria-label="Volgende foto">&#8250;</button>
      <p class="fotobox__bijschrift"><span class="fotobox__teller" id="fotoboxTeller"></span></p>
    </div>
  </div>

</Travel>
