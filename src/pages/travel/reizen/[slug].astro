---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import Travel from "../../../layouts/Travel.astro";
import travel from "../../../../public/content/travel-settings.json";
import { alleReizen, prijsTekst, vertrekTekst, vertrekKort } from "../../../lib/reizen.mjs";

/* Elke reis uit src/content/reizen/ krijgt tijdens het bouwen een eigen pagina,
   met de bestandsnaam als adres: bon-bini.md wordt /travel/reizen/bon-bini/.
   Reizen die op onzichtbaar staan, krijgen geen pagina. */
export async function getStaticPaths() {
  const reizen = await alleReizen();
  return reizen.map((reis) => ({ params: { slug: reis.id }, props: { reis } }));
}

const { reis } = Astro.props;
const d = reis.data;
const { Content } = await render(reis);

/* De badges bovenaan. Wat niet ingevuld is, valt gewoon weg. */
const vertrek = vertrekTekst(d);
const kenmerken = [
  { icoon: "💶", label: prijsTekst(d.prijs), extra: d.prijsnoot },
  { icoon: "📅", label: vertrek ? "Vertrek " + vertrek : "", extra: "" },
  { icoon: "🌙", label: d.duur, extra: "" },
  { icoon: "✈️", label: d.luchthaven ? "Vanuit " + d.luchthaven : "", extra: "" },
].filter((k) => k.label);

/* Grote versies voor het fotovenster; travel.js leest ze uit data-fotos. */
const groot = await Promise.all(d.fotos.map((f) => getImage({ src: f, width: 1600 })));

/* Het aanvraagformulier vult zichzelf in met wat hier in het adres meegaat. */
const aanvraag = "/travel/contact/?" + new URLSearchParams({
  reis: reis.id,
  bestemming: d.bestemming,
  titel: d.titel,
  vertrek: vertrekKort(d),
}).toString();
---
<Travel
  titel={`${d.titel} | Moda Travel`}
  omschrijving={d.samenvatting || `Reis naar ${d.bestemming} met Moda Travel.`}
  actief="bestemmingen">

  <!-- ===================== REIS IN BEELD ===================== -->
  <section class="section reisdetail" id="reis">
    <div class="container">
      <a class="reisdetail__terug" href="/travel/bestemmingen/">← Alle bestemmingen</a>

      <div class="reisdetail__kop">
        <h1 class="reisdetail__titel">{d.titel}</h1>
        {d.samenvatting && <p class="reisdetail__sub">{d.samenvatting}</p>}
      </div>

      <div class="reisdetail__hoofdfoto">
        <Image src={d.fotos[0]} width={1400} loading="eager"
               alt={`${d.bestemming} — ${d.titel}`} />
      </div>

      {kenmerken.length > 0 && (
        <div class="reisdetail__kenmerken">
          {kenmerken.map((k) => (
            <div class="reisdetail__kenmerk">
              <span class="reisdetail__icoon" aria-hidden="true">{k.icoon}</span>
              <span>
                <strong>{k.label}</strong>
                {k.extra && <em>{k.extra}</em>}
              </span>
            </div>
          ))}
        </div>
      )}

      <div class="reisdetail__body">
        <div class="reisdetail__tekst">
          <h2>Over deze reis</h2>
          <Content />

          {d.inbegrepen.length > 0 && (
            <Fragment>
              <h2>Wat is inbegrepen</h2>
              <ul class="reisdetail__lijst">
                {d.inbegrepen.map((punt) => <li>{punt}</li>)}
              </ul>
            </Fragment>
          )}

          {d.reisstijl && (
            <p class="reisdetail__stijl">
              Deze reis hoort bij <a href="/travel/reisstijlen/">{d.reisstijl.toLowerCase()}</a>.
            </p>
          )}
        </div>

        <aside class="reisdetail__kaart">
          <h3>Interesse in deze reis?</h3>
          <p>Wij stemmen alles af op jouw wensen: data, verblijf en vervoer naar de luchthaven.</p>
          <a class="btn btn--primary btn--block" href={aanvraag}>Vraag deze reis aan</a>
          <a class="btn btn--ghost btn--block" href={`tel:${travel.telefoon_link}`}>📞 {travel.telefoon_weergave}</a>
          {d.instagram && (
            <a class="reisdetail__insta" href={d.instagram} target="_blank" rel="noopener">Bekijk op Instagram</a>
          )}
        </aside>
      </div>

      {d.fotos.length > 1 && (
        <div class="reisdetail__fotos">
          <h2>In beeld</h2>
          <div class="reisdetail__raster">
            {d.fotos.map((foto, i) => (
              <button type="button" class="reisfoto" data-i={i} aria-label={`Foto ${i + 1} groter bekijken`}>
                <Image src={foto} width={700} alt={`${d.titel}, foto ${i + 1}`} />
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Fotovenster voor de galerij van deze reis -->
  <div class="fotobox" id="fotobox" aria-hidden="true" data-fotos={groot.map((g) => g.src).join("|")}>
    <div class="fotobox__achtergrond" data-sluit></div>
    <div class="fotobox__paneel" role="dialog" aria-modal="true" aria-label="Foto van de reis">
      <button class="fotobox__sluit" type="button" data-sluit aria-label="Venster sluiten">&times;</button>
      <button class="fotobox__nav fotobox__nav--vorige" type="button" data-stap="-1" aria-label="Vorige foto">&#8249;</button>
      <img class="fotobox__foto" id="fotoboxFoto" src="" alt="" />
      <button class="fotobox__nav fotobox__nav--volgende" type="button" data-stap="1" aria-label="Volgende foto">&#8250;</button>
      <p class="fotobox__bijschrift"><span class="fotobox__teller" id="fotoboxTeller"></span></p>
    </div>
  </div>

</Travel>
