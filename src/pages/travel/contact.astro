---
import Travel from "../../layouts/Travel.astro";
---
<Travel
  titel="Contact | Moda Travel"
  omschrijving="Maak een afspraak of vraag vrijblijvend een reisvoorstel aan bij Moda Travel in Heusden-Zolder."
  actief="contact">

  <section class="section" id="offerte">
    <div class="container booking">
      <div class="booking__intro reveal">
        <p class="section__eyebrow">Reis aanvragen</p>
        <h2 class="section__title">Vertel ons over jouw reis</h2>
        <p class="section__lead">
          Vul kort in wat je in gedachten hebt en wij bezorgen je een voorstel op maat.
          Liever meteen bellen of WhatsAppen? Dat kan ook.
        </p>
        <ul class="booking__contactlist">
          <li><span>📞</span> <a href="tel:+3211243003">011 24 30 03</a></li>
          <li><span>✉️</span> <a href="mailto:info@modatravel.be">info@modatravel.be</a></li>
          <li><span>📍</span> <a href="https://www.google.com/maps/search/?api=1&amp;query=Beringersteenweg+14+3550+Heusden-Zolder" target="_blank" rel="noopener">Beringersteenweg 14, 3550 Heusden-Zolder</a></li>
        </ul>
        <div class="quickcontact">
          <a href="tel:+3211243003" class="btn btn--sm btn--primary">📞 Bel direct</a>
          <a href="https://wa.me/32000000000?text=Hallo%2C%20ik%20heb%20een%20reisvraag%20voor%20Moda%20Travel"
             class="btn btn--sm btn--wa" target="_blank" rel="noopener">
            <svg class="btn__wa" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#wa-icon"/></svg>
            WhatsApp
          </a>
          <a href="https://www.instagram.com/modatravel_/" class="btn btn--sm btn--ghost" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>

      <form class="booking__form reveal" id="quoteForm" novalidate>
        <!-- Spam-val (onzichtbaar; enkel bots vinken dit aan) -->
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div class="field">
          <label for="name">Naam</label>
          <input type="text" id="name" name="name" placeholder="Uw naam" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Telefoon</label>
            <input type="tel" id="phone" name="phone" placeholder="+32 ..." required />
          </div>
          <div class="field">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="u@voorbeeld.be" required />
          </div>
        </div>
        <div class="field">
          <label for="destination">Gewenste bestemming</label>
          <input type="text" id="destination" name="destination" placeholder="Bv. Thailand, een citytrip, of nog geen idee ..." required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="triptype">Type reis</label>
            <select id="triptype" name="triptype">
              <option value="" disabled selected>Kies een reisstijl</option>
              <option>Citytrip</option>
              <option>Begeleide groepsreis</option>
              <option>Zon &amp; strand</option>
              <option>Verre reis / rondreis</option>
              <option>Huwelijksreis</option>
              <option>Avontuur &amp; natuur</option>
              <option>Nog geen idee</option>
            </select>
          </div>
          <div class="field">
            <label for="travellers">Aantal reizigers</label>
            <input type="number" id="travellers" name="travellers" min="1" placeholder="2" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="period">Reisperiode</label>
            <input type="text" id="period" name="period" placeholder="Bv. juli 2026, ongeveer 10 dagen" />
          </div>
          <div class="field">
            <label for="budget">Budget per persoon (optioneel)</label>
            <input type="text" id="budget" name="budget" placeholder="Bv. 1500 euro" />
          </div>
        </div>
        <div class="field">
          <label for="notes">Opmerkingen (optioneel)</label>
          <textarea id="notes" name="notes" rows="3" placeholder="Wensen, gelegenheid, met kinderen, bijzonderheden ..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block">Vraag mijn reisvoorstel aan</button>
        <p class="booking__note" id="formNote" role="status"></p>
      </form>
    </div>
  </section>

</Travel>
