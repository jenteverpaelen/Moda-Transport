---
import { Image } from "astro:assets";
import Travel from "../../layouts/Travel.astro";
import { alleReizen, tegelLabel } from "../../lib/reizen.mjs";

/* De tegels hieronder komen rechtstreeks uit de reizen die het reisbureau zelf
   beheert op /admin/. Een reis toevoegen = een tegel erbij én een eigen
   reispagina; een reis verwijderen of op onzichtbaar zetten = tegel weg. */
const reizen = await alleReizen();

/* De uitgelichte reis krijgt de grote tegel en komt dus vooraan. */
const uitgelicht = reizen.filter((r) => r.data.uitgelicht);
const rest = reizen.filter((r) => !r.data.uitgelicht);
const geordend = [...uitgelicht, ...rest];

/* Vorm van het mozaïek: één grote tegel (2 bij 2), daarnaast twee gewone,
   en daarna brede tegels twee per rij. De allerlaatste tegel wordt over de
   volle breedte getrokken als er anders een gat zou overblijven, zodat het
   raster bij élk aantal reizen netjes afsluit. */
const aantalTegels = geordend.length + 1; // + de vaste tegel "Jouw droomreis"
const laatsteVult = aantalTegels > 3 && (aantalTegels - 4) % 2 === 1;

function vorm(i) {
  if (i === 0) return "moz moz--groot";
  if (i <= 2) return "moz";
  if (laatsteVult && i === aantalTegels - 1) return "moz moz--vol";
  return "moz moz--breed";
}
---
<Travel
  titel="Bestemmingen | Moda Travel"
  omschrijving="Ontdek de reizen die Moda Travel voor je samenstelt: van zon en zee tot verre rondreizen, stedentrips en winterse groepsreizen. Alles kan volledig op maat."
  actief="bestemmingen">

  <section class="section" id="bestemmingen">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Bestemmingen</p>
        <h2 class="section__title">Een greep uit <span class="text-accent">onze reizen</span></h2>
        <p class="section__lead">
          Zorgvuldig gekozen plekken, van sneeuw en noorderlicht tot zon en zee.
          Alles kan volledig op maat.
        </p>
      </div>

      <div class="mozaiek">
        {geordend.map((reis, i) => (
          <a class={vorm(i) + " reveal"} href={`/travel/reizen/${reis.id}/`}
             aria-label={`Bekijk de reis ${reis.data.titel}`}>
            {tegelLabel(reis.data) && <span class="moz__label">{tegelLabel(reis.data)}</span>}
            <Image src={reis.data.fotos[0]} width={900}
                   alt={`${reis.data.bestemming} — ${reis.data.titel}`} />
            <span class="moz__tekst">
              <span class="moz__naam">{reis.data.bestemming}</span>
              <span class="moz__regel">{reis.data.samenvatting || reis.data.titel}</span>
            </span>
          </a>
        ))}

        <a class={vorm(geordend.length) + " reveal"} href="/travel/contact/"
           aria-label="Vraag een reis op maat aan">
          <span class="moz__label">Op maat</span>
          <img src="/assets/images/travel/hero-alt.jpg" alt="Een koppel op reis bij zonsondergang" loading="lazy" />
          <span class="moz__tekst">
            <span class="moz__naam">Jouw droomreis</span>
            <span class="moz__regel">Een andere bestemming? Wij stellen ze samen</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="laatste-reizen">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Volg mee</p>
        <h2 class="section__title">Onze <span class="text-accent">laatste reizen</span></h2>
        <p class="section__lead">
          Elke reis vertelt een verhaal. Op Instagram delen we sfeerbeelden en de
          reizen die we net hebben samengesteld.
        </p>
      </div>

      <div class="reisfeed__bar reveal">
        <a class="reisfeed__handle" href="https://www.instagram.com/modatravel_/" target="_blank" rel="noopener">
          <span class="reisfeed__ig" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/>
            </svg>
          </span>
          @modatravel_
        </a>
        <a class="btn btn--sm btn--ghost" href="https://www.instagram.com/modatravel_/" target="_blank" rel="noopener">Volg ons op Instagram</a>
      </div>

      <!-- Wordt gevuld door travel.js met de ECHTE Instagram-posts, zodra er een
           feed-URL is ingesteld (data-feed-url hieronder of de constante bovenaan
           travel.js). Zolang die er niet is, blijft dit blok leeg en zie je enkel
           de volgknop hierboven. De reizen zelf staan in het mozaïek. -->
      <div class="reizen" id="reisfeed" data-feed-url="" hidden></div>
    </div>
  </section>

</Travel>
