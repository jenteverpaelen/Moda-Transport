---
import Luchthaven from "../../layouts/Luchthaven.astro";
---
<Luchthaven
  titel="Moda Transport | Luchthavenvervoer Limburg | Reizen zonder zorgen"
  omschrijving="Exclusief luchthavenvervoer vanuit Heusden-Zolder en heel Limburg. Stipt en comfortabel naar Zaventem, Charleroi en Schiphol, aan een vaste prijs."
  actief="home"
  heeftHero={true}>

  <section class="hero" id="home">
    <div class="hero__media" aria-hidden="true">
      <div class="hero__img" style="background-image:url('/assets/images/fleet.jpeg')"></div>
      <div class="hero__overlay"></div>
    </div>

    <div class="container hero__content">
      <p class="hero__eyebrow reveal">✦ Exclusief luchthavenvervoer</p>
      <h1 class="hero__title reveal">
        Reizen <span class="text-accent">zonder zorgen</span><br />
        naar elke luchthaven.
      </h1>
      <p class="hero__sub reveal">
        Comfortabel, stipt en aan een vaste prijs. Wij brengen u met een luxe
        Mercedes veilig naar Zaventem, Charleroi, Schiphol en verder, dag en nacht.
      </p>

      <div class="hero__actions reveal">
        <a href="/luchthaven/reserveren/" class="btn btn--primary btn--lg">Reserveer uw rit</a>
        <a href="/luchthaven/prijs/" class="btn btn--ghost btn--lg">
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2.5" width="14" height="19" rx="2.5"></rect>
            <line x1="8.5" y1="6.5" x2="15.5" y2="6.5"></line>
            <line x1="8.5" y1="11" x2="8.5" y2="11"></line>
            <line x1="12" y1="11" x2="12" y2="11"></line>
            <line x1="15.5" y1="11" x2="15.5" y2="11"></line>
            <line x1="8.5" y1="14.5" x2="8.5" y2="14.5"></line>
            <line x1="12" y1="14.5" x2="12" y2="14.5"></line>
            <line x1="15.5" y1="14.5" x2="15.5" y2="18"></line>
            <line x1="8.5" y1="18" x2="12" y2="18"></line>
          </svg>
          Prijs berekenen
        </a>
        <!-- WhatsApp-nummer: vervang 32000000000 door je echte gsm-nummer
             (landcode zonder +, bv. 32470123456). Zelfde nummer ook bij
             de zwevende knop onderaan deze pagina. -->
        <a href="https://wa.me/32000000000?text=Hallo%2C%20ik%20heb%20een%20vraag%20over%20luchthavenvervoer%20met%20Moda%20Transport"
           class="btn btn--wa btn--lg" target="_blank" rel="noopener" data-content="whatsapp">
          <svg class="btn__wa" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#wa-icon"/></svg>
          Chat via WhatsApp
        </a>
      </div>

      <div class="hero__badges reveal">
        <span>★★★★★ Top beoordeeld op Google</span>
        <span class="dot"></span>
        <span>24/7 beschikbaar</span>
        <span class="dot"></span>
        <span>Vaste prijs vooraf</span>
      </div>
    </div>

    <a href="/luchthaven/diensten/" class="hero__scroll" aria-label="Scroll naar beneden">
      <span class="hero__mouse"></span>
    </a>
  </section>

  <section class="stats">
    <div class="container stats__grid">
      <div class="stat reveal">
        <span class="stat__num" data-count="100" data-suffix="%">0</span>
        <span class="stat__label">Stipt &amp; betrouwbaar</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num stat__num--text">24/7</span>
        <span class="stat__label">Altijd beschikbaar</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num stat__num--stars">★★★★★</span>
        <span class="stat__label">Top beoordeeld op Google</span>
      </div>
      <div class="stat reveal">
        <span class="stat__num stat__num--text">€</span>
        <span class="stat__label">Vaste prijs vooraf</span>
      </div>
    </div>
  </section>

  <!-- ===================== WEGWIJZER ===================== -->
  <section class="section" id="ontdek">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Ontdek</p>
        <h2 class="section__title">Waarmee kunnen wij u <span class="text-accent">van dienst zijn?</span></h2>
      </div>
      <div class="cards">
        <a class="card reveal" href="/luchthaven/prijs/">
          <div class="card__icon">🧮</div>
          <h3>Prijs berekenen</h3>
          <p>Bereken meteen een vaste richtprijs voor uw rit naar de luchthaven.</p>
        </a>
        <a class="card reveal" href="/luchthaven/vloot/">
          <div class="card__icon">🚘</div>
          <h3>Onze vloot</h3>
          <p>Comfortabele Mercedes-wagens, ruim en verzorgd.</p>
        </a>
        <a class="card reveal" href="/luchthaven/reviews/">
          <div class="card__icon">⭐</div>
          <h3>Reviews</h3>
          <p>Lees wat andere reizigers over onze service zeggen.</p>
        </a>
        <a class="card reveal" href="/luchthaven/reserveren/">
          <div class="card__icon">📅</div>
          <h3>Reserveren</h3>
          <p>Leg uw rit vast, wij bevestigen zo snel mogelijk.</p>
        </a>
      </div>
    </div>
  </section>


</Luchthaven>
