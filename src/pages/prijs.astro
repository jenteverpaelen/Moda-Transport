---
import { Image } from "astro:assets";
import Moda from "../layouts/Moda.astro";
import instellingen from "../../public/content/settings.json";
import prijzen from "../../public/content/prices.json";
import vertrekbord from "../assets/luchthaven/vertrekbord.jpg";

const duur = (m) => {
  const u = Math.floor(m / 60), r = m % 60;
  return u ? `${u}u${String(r).padStart(2, "0")}` : `${r} min`;
};

const vragen = [
  { v: "Is dit de prijs per persoon of voor de hele wagen?", a: `Voor de hele wagen, tot ${prijzen.basisprijs_personen} personen. Vanaf de derde persoon komt er € ${prijzen.supplement_per_extra_persoon} per persoon bij.` },
  { v: "Kan de prijs achteraf nog veranderen?", a: "Nee. U krijgt één bedrag bij de bevestiging en dat blijft staan, ook bij file, omleiding of vertraging." },
  { v: "Rekenen jullie een nachttoeslag?", a: "Nee. De meeste ritten vertrekken 's nachts; dat is bij ons het normale uur en geen uitzondering waar iets voor betaald moet worden." },
  { v: "Wat kost een tussenstop?", a: `€ ${prijzen.supplement_per_tussenstop} per stop, als u die op voorhand doorgeeft. Onderweg iets bijbedenken kan, maar dan spreken we het ter plaatse af.` },
  { v: "Hoe betaal ik?", a: "Cash of via overschrijving, wat u het beste uitkomt. Voor bedrijven maken we een factuur." },
];
---
<Moda
  titel="Tarieven | Moda luchthavenvervoer"
  omschrijving="Vaste prijzen naar Zaventem, Charleroi, Eindhoven, Luik, Düsseldorf, Schiphol en Weeze. Prijs per wagen, tot acht personen, vooraf afgesproken."
  actief="prijs">

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">De prijs staat vast voor u vertrekt.</h1>
      <div class="pkop__onder">
        <p class="lood">
          Eén bedrag voor de hele wagen, afgesproken bij de bevestiging. Wat er
          onderweg ook gebeurt — file, omleiding, een vlucht die drie uur later
          gaat — dat bedrag verandert niet.
        </p>
        <div class="pkop__cijfers">
          <div><span>Inbegrepen personen</span><span class="getal">{prijzen.basisprijs_personen}</span></div>
          <div><span>Per extra persoon</span><span class="getal">€ {prijzen.supplement_per_extra_persoon}</span></div>
          <div><span>Heen en terug samen</span><span class="getal">−{prijzen.heenterug_korting_procent}%</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       DE REKENAAR
       Het bord op de startpagina zegt hoe laat we aanbellen; dit zegt wat het
       kost voor jouw adres, jouw gezelschap en jouw tussenstops.
       ===================================================================== -->
  <section class="blok" style="padding-top:0" id="rekenen">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Reken uw eigen prijs uit</h2>
        <p class="sectiekop__noot">
          Vul uw ophaaladres in, dan kijken we meteen na of u binnen onze
          vaste-prijszone van {prijzen.km_straal} km valt.
        </p>
      </div>

      <div class="rekenaar toon" id="rekenaar" data-regels={JSON.stringify({
        luchthavens: prijzen.luchthavens.map((l) => ({ value: l.value, label: l.label, price: l.price })),
        basisprijs_personen: prijzen.basisprijs_personen,
        supplement_per_extra_persoon: prijzen.supplement_per_extra_persoon,
        supplement_per_tussenstop: prijzen.supplement_per_tussenstop,
        heenterug_korting_procent: prijzen.heenterug_korting_procent,
        km_straal: prijzen.km_straal,
      })}>
        <div class="rekenaar__velden">
          <div class="veld veld--vol">
            <label for="rekAdres">Waar halen we u op</label>
            <div class="zoekveld">
              <input type="text" id="rekAdres" placeholder="Straat en nummer, gemeente"
                     autocomplete="off" role="combobox" aria-expanded="false"
                     aria-controls="rekSuggesties" aria-autocomplete="list"
                     style="font-family:var(--tekst); font-size:1.05rem; letter-spacing:0" />
              <ul class="suggesties" id="rekSuggesties" role="listbox" aria-label="Adressuggesties" hidden></ul>
            </div>
          </div>

          <div class="veld veld--vol">
            <label id="rekRichtingLabel">Wat wilt u boeken</label>
            <div class="richting" role="radiogroup" aria-labelledby="rekRichtingLabel">
              <input type="radio" name="rekRichting" id="rekHeen" value="heen" checked />
              <label for="rekHeen">Naar de luchthaven</label>
              <input type="radio" name="rekRichting" id="rekVan" value="van" />
              <label for="rekVan">Van de luchthaven</label>
              <input type="radio" name="rekRichting" id="rekBeide" value="beide" />
              <label for="rekBeide">Heen én terug</label>
            </div>
          </div>

          <div class="veld">
            <label for="rekLuchthaven">Welke luchthaven</label>
            <select id="rekLuchthaven">
              {prijzen.luchthavens.map((l) => (
                <option value={l.value} selected={l.value === "zaventem"}>{l.label}</option>
              ))}
            </select>
          </div>

          <div class="veld">
            <label for="rekPersonen">Aantal personen</label>
            <input type="number" id="rekPersonen" min="1" max="8" step="1" value="2" />
          </div>

          <div class="veld veld--vol" id="rekTerugVak" hidden>
            <label for="rekTerugLuchthaven">Van welke luchthaven komt u terug</label>
            <select id="rekTerugLuchthaven">
              {prijzen.luchthavens.map((l) => (
                <option value={l.value} selected={l.value === "zaventem"}>{l.label}</option>
              ))}
            </select>
          </div>

          <div class="veld veld--vol">
            <label>Tussenstops (mag leeg)</label>
            <div class="stops" id="rekStops"></div>
            <button type="button" class="stopbij" id="rekStopBij">
              <svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg>
              Tussenstop toevoegen — € {prijzen.supplement_per_tussenstop} per stop
            </button>
          </div>
        </div>

        <!-- Wordt door moda.js ingevuld. Zonder JavaScript staat hier de
             prijslijst eronder, en die klopt ook. -->
        <div class="uitkomst" id="rekUitkomst" aria-live="polite">
          <p class="klein">Vul hierboven in wat u nodig heeft, dan verschijnt de prijs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DE PRIJSLIJST ===================== -->
  <section class="blok" style="padding-top:0" id="tarieven">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">De vaste prijzen</h2>
        <p class="sectiekop__noot">
          Enkele rit vanuit Heusden-Zolder, voor de hele wagen tot
          {prijzen.basisprijs_personen} personen.
        </p>
      </div>

      <div class="routes">
        <div class="routes__kop">
          <span>Bestemming</span><span>Afstand</span><span>Rit</span><span>Vaste prijs</span><span></span>
        </div>
        {prijzen.luchthavens.map((l) => (
          <a class="route" href={`/reserveren/?luchthaven=${l.value}`}>
            <span class="route__naam">{l.label}</span>
            <span class="route__km">{l.km} km</span>
            <span class="route__duur">{duur(l.rijtijd_min)}</span>
            <span class="route__prijs">€ {l.price}</span>
            <span class="route__pijl"><svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg></span>
          </a>
        ))}
      </div>

      <p class="klein" style="margin-top:20px">
        Vanaf de derde persoon komt er € {prijzen.supplement_per_extra_persoon} per persoon bij.
        Een tussenstop kost € {prijzen.supplement_per_tussenstop}.
        Heen en terug samen geboekt geeft {prijzen.heenterug_korting_procent}% korting.
        Ligt uw adres verder dan {prijzen.km_straal} km buiten Heusden-Zolder, dan
        spreken we de prijs vooraf samen af — ook dan hoort u het bedrag voor u vertrekt.
      </p>
    </div>
  </section>

  <section class="blok blok--asfalt">
    <div class="container detail">
      <div class="detail__beeld toon"><Image src={vertrekbord} width={900} alt="Vertrekbord in een luchthaven" /></div>
      <div class="toon">
        <h2 class="detail__naam">Waarom er geen meter meeloopt</h2>
        <p class="lood">
          Een taxameter is eerlijk voor korte ritten in de stad. Voor een rit
          naar Zaventem om vier uur 's ochtends is hij vooral spannend: u weet
          pas wat het kost als u er al bent.
        </p>
        <p class="lood">
          Wij doen het omgekeerd. U hoort het bedrag bij de bevestiging, en
          daarna is het onze zorg of de ring vastloopt.
        </p>
        <div class="slot__acties" style="margin-top:26px">
          <a class="knop knop--signaal" href="/reserveren/">
            Reserveer uw rit <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="blok">
    <div class="container smal">
      <div class="sectiekop toon">
        <h2 class="groot">Over de prijs</h2>
        <p class="sectiekop__noot">De vragen die hier het vaakst over gaan.</p>
      </div>
      <div class="vragen toon">
        {vragen.map((q) => (
          <details class="vraag">
            <summary>{q.v}<span class="vraag__teken"><svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg></span></summary>
            <p class="vraag__antwoord">{q.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="slot">
    <div class="container">
      <h2 class="reus">Twijfelt u over uw situatie? Bel even.</h2>
      <p class="slot__lead">
        Een ongewoon adres, een groep van elf, een vlucht midden in de nacht —
        we zeggen u meteen wat het kost.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
        <a class="knop" href="/reserveren/">Reserveer online</a>
      </div>
    </div>
  </section>
</Moda>
