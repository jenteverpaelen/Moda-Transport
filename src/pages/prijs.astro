---
import { Image } from "astro:assets";
import Moda from "../layouts/Moda.astro";
import instellingen from "../../public/content/settings.json";
import prijzen from "../../public/content/prices.json";
import vertrekbord from "../assets/luchthaven/vertrekbord.jpg";

const duur = (m) => {
  const u = Math.floor(m / 60), r = m % 60;
  return u ? `${u}u${String(r).padStart(2, "0")}` : `${r} min`;
};

const vragen = [
  { v: "Is dit de prijs per persoon of voor de hele wagen?", a: `Voor de hele wagen, tot ${prijzen.basisprijs_personen} personen. Vanaf de derde persoon komt er € ${prijzen.supplement_per_extra_persoon} per persoon bij.` },
  { v: "Kan de prijs achteraf nog veranderen?", a: "Nee. U krijgt één bedrag bij de bevestiging en dat blijft staan, ook bij file, omleiding of vertraging." },
  { v: "Rekenen jullie een nachttoeslag?", a: "Nee. De meeste ritten vertrekken 's nachts; dat is bij ons het normale uur en geen uitzondering waar iets voor betaald moet worden." },
  { v: "Wat kost een tussenstop?", a: `€ ${prijzen.supplement_per_tussenstop} per stop, als u die op voorhand doorgeeft. Onderweg iets bijbedenken kan, maar dan spreken we het ter plaatse af.` },
  { v: "Hoe betaal ik?", a: "Cash of via overschrijving, wat u het beste uitkomt. Voor bedrijven maken we een factuur." },
];
---
<Moda
  titel="Tarieven | Moda luchthavenvervoer"
  omschrijving="Vaste prijzen naar Zaventem, Charleroi, Eindhoven, Luik, Düsseldorf, Schiphol en Weeze. Prijs per wagen, tot acht personen, vooraf afgesproken."
  actief="prijs">

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">De prijs staat vast voor u vertrekt.</h1>
      <div class="pkop__onder">
        <p class="lood">
          Eén bedrag voor de hele wagen, afgesproken bij de bevestiging. Wat er
          onderweg ook gebeurt — file, omleiding, een vlucht die drie uur later
          gaat — dat bedrag verandert niet.
        </p>
        <div class="pkop__cijfers">
          <div><span>Inbegrepen personen</span><span class="getal">{prijzen.basisprijs_personen}</span></div>
          <div><span>Per extra persoon</span><span class="getal">€ {prijzen.supplement_per_extra_persoon}</span></div>
          <div><span>Heen en terug samen</span><span class="getal">−{prijzen.heenterug_korting_procent}%</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- De tabel rekent mee met het aantal personen en met heen en terug. -->
  <section class="blok" style="padding-top:0" id="tarieven">
    <div class="container">
      <div class="bord" style="max-width:none; margin-bottom:clamp(22px,3vw,34px)">
        <div class="bord__stel">
          <div class="veld">
            <label for="tarPersonen">Met hoeveel personen</label>
            <input type="number" id="tarPersonen" min="1" max="8" step="1" value="2" />
          </div>
          <div class="veld">
            <label for="tarRichting">Heen, of heen en terug</label>
            <select id="tarRichting">
              <option value="heen" selected>Alleen heen</option>
              <option value="beide">Heen en terug (−{prijzen.heenterug_korting_procent}%)</option>
            </select>
          </div>
        </div>
        <p class="bord__noot" style="padding-top:12px">
          De tabel hieronder past zich meteen aan. Dit is de prijs voor de hele
          wagen, niet per persoon.
        </p>
      </div>

      <div class="routes" data-tarieven>
        <div class="routes__kop">
          <span>Bestemming</span><span>Afstand</span><span>Rit</span><span>Prijs</span><span></span>
        </div>
        {prijzen.luchthavens.map((l) => (
          <a class="route" href={`/reserveren/?luchthaven=${l.value}`}
             data-basis={l.price}>
            <span class="route__naam">{l.label}</span>
            <span class="route__km">{l.km} km</span>
            <span class="route__duur">{duur(l.rijtijd_min)}</span>
            <span class="route__prijs" data-prijs>€ {l.price}</span>
            <span class="route__pijl"><svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg></span>
          </a>
        ))}
      </div>

      <p class="klein" style="margin-top:20px">
        Een tussenstop kost € {prijzen.supplement_per_tussenstop}. Rijden we naar een
        adres verder dan {prijzen.km_straal} km buiten Heusden-Zolder, dan spreken we
        de prijs vooraf samen af — ook dan hoort u het bedrag voor u vertrekt.
      </p>
    </div>
  </section>

  <section class="blok blok--asfalt">
    <div class="container detail">
      <div class="detail__beeld toon"><Image src={vertrekbord} width={900} alt="Vertrekbord in een luchthaven" /></div>
      <div class="toon">
        <h2 class="detail__naam">Waarom er geen meter meeloopt</h2>
        <p class="lood">
          Een taxameter is eerlijk voor korte ritten in de stad. Voor een rit
          naar Zaventem om vier uur 's ochtends is hij vooral spannend: u weet
          pas wat het kost als u er al bent.
        </p>
        <p class="lood">
          Wij doen het omgekeerd. U hoort het bedrag bij de bevestiging, en
          daarna is het onze zorg of de ring vastloopt.
        </p>
        <div class="slot__acties" style="margin-top:26px">
          <a class="knop knop--signaal" href="/reserveren/">
            Reserveer uw rit <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="blok">
    <div class="container smal">
      <div class="sectiekop toon">
        <h2 class="groot">Over de prijs</h2>
        <p class="sectiekop__noot">De vragen die hier het vaakst over gaan.</p>
      </div>
      <div class="vragen toon">
        {vragen.map((q) => (
          <details class="vraag">
            <summary>{q.v}<span class="vraag__teken"><svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg></span></summary>
            <p class="vraag__antwoord">{q.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="slot">
    <div class="container">
      <h2 class="reus">Twijfelt u over uw situatie? Bel even.</h2>
      <p class="slot__lead">
        Een ongewoon adres, een groep van elf, een vlucht midden in de nacht —
        we zeggen u meteen wat het kost.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
        <a class="knop" href="/reserveren/">Reserveer online</a>
      </div>
    </div>
  </section>
</Moda>
