---
import { Image } from "astro:assets";
import Moda from "../layouts/Moda.astro";
import instellingen from "../../public/content/settings.json";
import prijzen from "../../public/content/prices.json";
import beoordelingen from "../../public/content/reviews.json";

import stuurNacht from "../assets/luchthaven/stuur-nacht.jpg";
import vertrekbord from "../assets/luchthaven/vertrekbord.jpg";
import vlootFoto from "../assets/luchthaven/vloot.jpg";
import interieurFoto from "../assets/luchthaven/interieur.jpg";
import deurFoto from "../assets/luchthaven/deur.jpg";

/* ---------- De terugrekening, ook al zonder JavaScript ----------
   De startwaarden worden hier al uitgerekend, zodat het bord meteen klopt en
   ook leesbaar is als het scriptje niet draait. De rekenregels staan één keer
   uitgelegd in public/assets/js/moda.js. */
const CHECKIN = 120, MARGE = 15, INLADEN = 5, OPSTAAN = 45;
const startVlucht = "10:35";
const startLucht = prijzen.luchthavens.find((l) => l.value === "zaventem");

const minuten = (t) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
const tijd = (m) => {
  const x = ((m % 1440) + 1440) % 1440;
  return String(Math.floor(x / 60)).padStart(2, "0") + ":" + String(x % 60).padStart(2, "0");
};
const duur = (m) => {
  const u = Math.floor(m / 60), r = m % 60;
  return u ? `${u}u${String(r).padStart(2, "0")}` : `${r} min`;
};

const v = minuten(startVlucht);
const balie = v - CHECKIN;
const wegrijden = balie - startLucht.rijtijd_min - MARGE;
const aanbellen = wegrijden - INLADEN;
const wekker = aanbellen - OPSTAAN;

const bordRijen = [
  { sleutel: "wekker",     wat: "Uw wekker gaat",     min: wekker },
  { sleutel: "aanbellen",  wat: "Wij bellen aan",     min: aanbellen, kern: true },
  { sleutel: "wegrijden",  wat: "Wij rijden weg",     min: wegrijden },
  { sleutel: "balie",      wat: "U staat aan de balie", min: balie },
  { sleutel: "balieDicht", wat: "De balie sluit",     min: v - 60 },
  { sleutel: "vlucht",     wat: "Uw vlucht vertrekt", min: v },
];

/* ---------- Reviews: echte Google-reviews, echte cijfers ---------- */
const alleReviews = beoordelingen.reviews;
const gemiddelde = (alleReviews.reduce((t, r) => t + r.stars, 0) / alleReviews.length).toFixed(1).replace(".", ",");
const uitgelicht = alleReviews.filter((r) => r.text && r.text.length > 30).slice(0, 6);
const datumKort = (d) => {
  const [j, m, dg] = d.split("-");
  return `${dg}.${m}.${j}`;
};

/* ---------- Wat er gebeurt terwijl u slaapt ---------- */
const stappen = [
  { nr: "01", wat: "U geeft uw vluchtuur door", uitleg: "Meer hebben we niet nodig. Wij rekenen terug wanneer we moeten aanbellen en bevestigen dat uur — telefonisch of per mail, niet met een automatische bevestiging waar niemand naar gekeken heeft." },
  { nr: "02", wat: "Wij volgen uw vlucht op", uitleg: "Vertrekt u later of landt u vroeger, dan schuift het ophaaluur mee. U hoeft ons niet te bellen; we hebben het meestal al gezien." },
  { nr: "03", wat: "Wij staan voor de deur", uitleg: "Vijf minuten voor we wegrijden staan we er. De koffers gaan achterin, u stapt in, en er hoeft niets meer geregeld te worden." },
  { nr: "04", wat: "Wij halen u weer op", uitleg: "Bij terugkomst staat dezelfde chauffeur in de aankomsthal. Loopt de bagageband uit, dan wachten we. Daar rekenen we niets extra voor." },
];

const vragen = [
  { v: "Hoe lang op voorhand moet ik reserveren?", a: "Liefst een paar dagen, maar bel gerust ook als het morgenvroeg is. Lukt het bij ons niet meer, dan zeggen we dat meteen in plaats van u te laten wachten." },
  { v: "Wat als mijn vlucht vertraging heeft?", a: "Wij volgen het vluchtnummer op en passen het ophaaluur aan. U betaalt niets extra voor die wachttijd." },
  { v: "Rijden jullie ook 's nachts?", a: "Ja. De meeste ritten vertrekken tussen drie en zes uur 's ochtends. Daar rekenen we geen nachttoeslag voor." },
  { v: "Met hoeveel personen kunnen we mee?", a: "Tot acht personen met bagage, in één wagen. Met meer rijden we met twee wagens; geef het door bij uw aanvraag." },
  { v: "Kan ik met kinderen meerijden?", a: "Ja. Kinderzitjes zijn gratis, maar vraag ze wel op voorhand aan zodat het juiste zitje in de wagen ligt." },
  { v: "Staat de prijs echt op voorhand vast?", a: "Ja. U krijgt één bedrag bij de bevestiging en dat verandert niet, ook niet bij file of omleiding." },
];
---
<Moda
  titel="Moda luchthavenvervoer | Vaste prijs vanuit Limburg naar de luchthaven"
  omschrijving="Luchthavenvervoer vanuit Heusden-Zolder en heel Limburg. Vaste prijs vooraf, eigen Mercedes-wagens, vluchtopvolging en een chauffeur die er staat. Reken hier uit hoe laat wij aanbellen."
  actief="home"
  opHero={true}>

  <!-- =====================================================================
       DE TERUGREKENING
       De startpagina opent niet met een banner maar met de vraag waarmee
       iedereen binnenkomt: ga ik mijn vlucht halen? Het bord rekent terug.
       ===================================================================== -->
  <section class="hero" id="hero">
    <div class="hero__doek" aria-hidden="true">
      <div class="hero__laag hero__laag--nacht"><Image src={stuurNacht} alt="" width={1800} loading="eager" fetchpriority="high" /></div>
      <div class="hero__laag hero__laag--dag"><Image src={vertrekbord} alt="" width={1800} loading="lazy" /></div>
    </div>

    <div class="container">
      <h1 class="hero__zin reus">Wij bellen aan om <span class="getal" data-bord-zin>{tijd(aanbellen)}</span>.</h1>

      <div class="bord" id="bord">
        <div class="bord__stel">
          <div class="veld">
            <label for="bordVlucht">Uw vlucht vertrekt om</label>
            <input type="time" id="bordVlucht" value={startVlucht} step="300" />
          </div>
          <div class="veld">
            <label for="bordLuchthaven">Naar welke luchthaven</label>
            <select id="bordLuchthaven">
              {prijzen.luchthavens.map((l) => (
                <option value={l.value} selected={l.value === "zaventem"}
                        data-prijs={l.price} data-km={l.km} data-rijtijd={l.rijtijd_min}>{l.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="bord__rijen">
          {bordRijen.map((r) => (
            <div class={"bordrij" + (r.kern ? " bordrij--kern" : "")} data-rij={r.sleutel}>
              <span class="bordrij__wat">{r.wat}</span>
              <span class="bordrij__tijd" data-tijd>{tijd(r.min)}</span>
              <span class="bordrij__delta" data-delta>{r.min < v ? "−" + duur(v - r.min) : ""}</span>
            </div>
          ))}
        </div>

        <div class="bord__slot">
          <div class="bord__feiten">
            <span class="bord__prijs" data-bord-prijs>€ {startLucht.price}</span>
            <span class="bord__bij" data-bord-bij>{startLucht.km} km · rit {duur(startLucht.rijtijd_min)} · tot 8 personen</span>
          </div>
          <div class="bord__acties">
            <a class="knop knop--signaal" href="/reserveren/" data-bord-knop>
              Reserveer deze rit
              <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
            </a>
            <a class="knop knop--stil" href={`tel:${instellingen.telefoon_link}`}>
              <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>
              {instellingen.telefoon_weergave}
            </a>
          </div>
        </div>

        <p class="bord__noot">
          Gerekend met twee uur inchecktijd en een kwartier marge voor verkeer.
          Rijtijden zijn schattingen bij normaal verkeer — bij uw bevestiging
          leggen we het uur samen vast.
        </p>
      </div>
    </div>
  </section>

  <hr class="baan" />

  <!-- =====================================================================
       TERWIJL U SLAAPT
       ===================================================================== -->
  <section class="blok" id="werkwijze">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Wat er gebeurt terwijl u nog slaapt</h2>
        <p class="sectiekop__noot">
          Vier dingen, en u hoeft er zelf maar één van te doen.
        </p>
      </div>

      {stappen.map((s) => (
        <article class="stap toon">
          <span class="stap__nr getal">{s.nr}</span>
          <h3 class="stap__wat">{s.wat}</h3>
          <p class="stap__uitleg">{s.uitleg}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- =====================================================================
       DE ROUTES — werkgebied en tarief in één tabel
       ===================================================================== -->
  <section class="blok blok--asfalt" id="tarieven">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Waar we rijden, en wat het kost</h2>
        <p class="sectiekop__noot">
          Vanuit Heusden-Zolder. De prijs is voor de hele wagen, tot acht
          personen — niet per persoon.
        </p>
      </div>

      <div class="routes toon">
        <div class="routes__kop">
          <span>Bestemming</span><span>Afstand</span><span>Rit</span><span>Vaste prijs</span><span></span>
        </div>
        {prijzen.luchthavens.map((l) => (
          <a class="route" href={`/reserveren/?luchthaven=${l.value}`}>
            <span class="route__naam">{l.label}</span>
            <span class="route__km">{l.km} km</span>
            <span class="route__duur">{duur(l.rijtijd_min)}</span>
            <span class="route__prijs">€ {l.price}</span>
            <span class="route__pijl"><svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg></span>
          </a>
        ))}
      </div>

      <p class="klein toon" style="margin-top:22px">
        Heen en terug samen geboekt? Dan gaat er {prijzen.heenterug_korting_procent}% af.
        Meer dan {prijzen.basisprijs_personen} personen: € {prijzen.supplement_per_extra_persoon} per extra persoon.
        Een tussenstop kost € {prijzen.supplement_per_tussenstop}.
      </p>

      <h3 class="sub toon" style="margin-top:clamp(30px,4vw,48px)">Wij halen op in heel Limburg</h3>
      <div class="plaatsen toon">
        {["Heusden-Zolder","Hasselt","Genk","Beringen","Lommel","Houthalen","Sint-Truiden","Tongeren","Bilzen","Diepenbeek","Zonhoven","Leopoldsburg","Maasmechelen","Peer","Bree","Diest"].map((p) => (
          <span class="plaats">{p}</span>
        ))}
        <span class="plaats plaats--meer">en de rest van de provincie</span>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       DE WAGENS
       ===================================================================== -->
  <section class="blok" id="vloot">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">U rijdt altijd in een Mercedes</h2>
        <p class="sectiekop__noot">
          Geen wisselend wagenpark. Twee wagens, allebei van ons, allebei
          onderhouden en gekeurd.
        </p>
      </div>

      <div class="wagens">
        <article class="wagen toon">
          <div class="wagen__beeld"><Image src={vlootFoto} width={900} alt="Mercedes V-Klasse van Moda" /></div>
          <div class="wagen__lijf">
            <h3 class="wagen__naam">Mercedes V-Klasse</h3>
            <p class="wagen__tekst">De standaardwagen. Losse verstelbare zetels, echte beenruimte, en een koffer die de bagage van een gezin slikt zonder dat er iets op schoot moet.</p>
            <ul class="wagen__specs">
              <li><span>Passagiers</span><span>tot 7</span></li>
              <li><span>Grote koffers</span><span>tot 7</span></li>
              <li><span>Zetels</span><span>leder, apart verstelbaar</span></li>
              <li><span>Achterin</span><span>eigen klimaatregeling</span></li>
            </ul>
            <a class="knop knop--stil knop--klein" href="/vloot/">
              Bekijk de vloot <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
            </a>
          </div>
        </article>

        <article class="wagen toon">
          <div class="wagen__beeld"><Image src={interieurFoto} width={900} alt="Lederen zetels achterin de Mercedes Vito" /></div>
          <div class="wagen__lijf">
            <h3 class="wagen__naam">Mercedes Vito</h3>
            <p class="wagen__tekst">Zelfde comfort, één rij extra. Voor een gezin met veel bagage, een groep vrienden die samen vertrekt, of een team op zakenreis.</p>
            <ul class="wagen__specs">
              <li><span>Passagiers</span><span>tot 8</span></li>
              <li><span>Grote koffers</span><span>tot 8</span></li>
              <li><span>Zetels</span><span>leder, drie rijen</span></li>
              <li><span>Kinderzitje</span><span>gratis, op aanvraag</span></li>
            </ul>
            <a class="knop knop--stil knop--klein" href="/vloot/">
              Bekijk de vloot <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       DE RITTEN — wat mensen achteraf schreven
       ===================================================================== -->
  <section class="blok blok--asfalt" id="reviews">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Wat mensen achteraf schreven</h2>
        <div class="sectiekop__noot">
          <div class="google">
            <span class="google__score">{gemiddelde}</span>
            <span class="rit__sterren" aria-hidden="true">
              {[1,2,3,4,5].map(() => (<svg class="ic ic--vol" aria-hidden="true"><use href="#ic-ster"/></svg>))}
            </span>
            <span class="google__uit">gemiddeld uit {alleReviews.length} Google-reviews</span>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="ritten toon">
        {uitgelicht.map((r) => (
          <article class="rit">
            <div class="rit__kop">
              <span class="rit__datum">{datumKort(r.date)}</span>
              <span class="rit__sterren" aria-label={`${r.stars} van de 5 sterren`}>
                {Array.from({ length: r.stars }).map(() => (<svg class="ic ic--vol" aria-hidden="true"><use href="#ic-ster"/></svg>))}
              </span>
            </div>
            <p class="rit__tekst">{r.text}</p>
            <p class="rit__naam">{r.name}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       VRAGEN
       ===================================================================== -->
  <section class="blok" id="vragen">
    <div class="container smal">
      <div class="sectiekop toon">
        <h2 class="groot">Vragen die we vaak krijgen</h2>
        <p class="sectiekop__noot">Staat het er niet bij? Bel gerust, we nemen zelf op.</p>
      </div>

      <div class="vragen toon">
        {vragen.map((q) => (
          <details class="vraag">
            <summary>
              {q.v}
              <span class="vraag__teken"><svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg></span>
            </summary>
            <p class="vraag__antwoord">{q.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SLOTOPROEP
       ===================================================================== -->
  <section class="slot">
    <div class="slot__beeld" aria-hidden="true"><Image src={deurFoto} width={1800} alt="" /></div>
    <div class="container">
      <h2 class="reus">Zeg ons uw vluchtuur. De rest is voor ons.</h2>
      <p class="slot__lead">
        U krijgt een vaste prijs en een vast ophaaluur, allebei op voorhand.
        Daarna hoeft u er niet meer aan te denken.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href="/reserveren/">
          Reserveer uw rit <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
        </a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>
          {instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>

</Moda>
