---
import { Image } from "astro:assets";
import Luchthaven from "../layouts/Luchthaven.astro";
import vlootFoto from "../assets/luchthaven/vloot.jpg";
import interieurFoto from "../assets/luchthaven/interieur.jpg";

/* De vier feiten onder de hero. Kort houden: dit is het eerste
   wat iemand leest terwijl de foto nog in beeld staat. */
const feiten = [
  { kop: "Live vluchtopvolging", uitleg: "Vertraagt uw vlucht? Dan schuift uw rit mee." },
  { kop: "24/7 beschikbaar", uitleg: "Ook 's nachts, in het weekend en op feestdagen." },
  { kop: "Vaste prijs vooraf", uitleg: "Bevestigd voor u boekt. Geen meter, geen verrassingen." },
  { kop: "★★★★★", uitleg: "Top beoordeeld op Google door reizigers uit Limburg.", sterren: true },
];

const stappen = [
  {
    nr: "01",
    titel: "U vraagt uw rit aan",
    tekst: "Bereken uw prijs of vul het formulier in. U krijgt een <strong>vaste prijs</strong> te zien voor u iets vastlegt, inclusief tol en parking.",
  },
  {
    nr: "02",
    titel: "Wij bevestigen persoonlijk",
    tekst: "Geen automatische mail, maar een bevestiging van ons. We spreken het ophaaluur af en houden rekening met uw <strong>inchecktijd</strong>.",
  },
  {
    nr: "03",
    titel: "Wij staan er, ook als de vlucht schuift",
    tekst: "We volgen uw vlucht live op. Landt u vroeger of later, dan passen we ons aan. <strong>Wachttijd rekenen we niet aan.</strong>",
  },
];

const wagens = [
  {
    foto: vlootFoto,
    naam: "Mercedes V-Klasse",
    tag: "Onze standaard",
    zin: "Ruime achterbank, apart zitcomfort en genoeg plaats om onderweg te werken of te slapen.",
    specs: [
      ["Passagiers", "tot 7"],
      ["Koffers", "tot 7 grote"],
      ["Comfort", "Leder, climate control"],
      ["Extra", "Water en lader aan boord"],
    ],
  },
  {
    foto: interieurFoto,
    naam: "Mercedes Vito",
    tag: "Voor grotere groepen",
    zin: "Zelfde comfort, meer plaats. Ideaal voor een gezin met bagage of een team dat samen vertrekt.",
    specs: [
      ["Passagiers", "tot 8"],
      ["Koffers", "tot 8 grote"],
      ["Comfort", "Leder, climate control"],
      ["Extra", "Kinderzitje op aanvraag"],
    ],
  },
];

const citaten = [
  { tekst: "Stipt, verzorgd en heel vriendelijk. De chauffeur stond er al voor we buitenkwamen.", naam: "Familie Vanderhoeven", plaats: "Heusden-Zolder → Zaventem" },
  { tekst: "Onze vlucht was drie uur vertraagd. Geen probleem, ze stonden er gewoon. Dat geeft rust.", naam: "Kris D.", plaats: "Schiphol → Beringen" },
  { tekst: "Vaste prijs afgesproken, en dat was ook de prijs. Zo simpel zou het altijd moeten zijn.", naam: "Ann M.", plaats: "Hasselt → Charleroi" },
];
---
<Luchthaven
  titel="Moda | Luchthavenvervoer Limburg | Persoonlijk, transparant, vertrouwd"
  omschrijving="Exclusief luchthavenvervoer vanuit Heusden-Zolder en heel Limburg. Vaste prijs vooraf, live vluchtopvolging en 24/7 beschikbaar. Naar Zaventem, Charleroi, Schiphol, Eindhoven en Düsseldorf."
  actief="home"
  heeftHero={true}>

  <!-- ===================== HERO ===================== -->
  <section class="lhero" id="home">
    <div class="lhero__beeld" aria-hidden="true">
      <Image src={vlootFoto} alt="" width={2000} loading="eager" fetchpriority="high" />
    </div>
    <div class="lhero__waas" aria-hidden="true"></div>

    <div class="lhero__inhoud">
      <div class="container">
        <div class="lhero__tekst">
          <p class="lhero__merk">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Persoonlijk · Transparant · Vertrouwd
          </p>

          <h1 class="lhero__titel">Zonder zorgen<br />naar de <em>luchthaven</em>.</h1>

          <p class="lhero__lead">
            Wij halen u thuis op in Heusden-Zolder en heel Limburg, en brengen u met
            een luxe Mercedes naar Zaventem, Charleroi, Schiphol, Eindhoven of
            Düsseldorf. Aan een prijs die vooraf vaststaat.
          </p>

          <div class="lhero__knoppen">
            <a href="/reserveren/" class="btn btn--primary btn--lg">Reserveer uw rit</a>
            <a href="/prijs/" class="btn btn--ghost btn--lg">Bereken uw prijs</a>
          </div>
        </div>
      </div>
    </div>

    <div class="lhero__balk">
      <div class="container">
        <dl class="lhero__feiten">
          {feiten.map((f) => (
            <div class="lhero__feit">
              <dt class={f.sterren ? "lhero__sterren" : ""}>{f.kop}</dt>
              <dd>{f.uitleg}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ===================== BELOFTE ===================== -->
  <section class="section belofte" id="ontdek">
    <div class="container">
      <h2 class="belofte__kop reveal">
        Een taxi brengt u ergens heen.<br />
        <span>Wij zorgen dat u er ontspannen aankomt.</span>
      </h2>

      <div class="belofte__drie">
        <article class="belofte__punt reveal">
          <h3>Persoonlijk</h3>
          <p>
            Geen callcenter en geen app die u aan een onbekende koppelt. U spreekt
            met de mensen die ook rijden, en u krijgt elke keer dezelfde verzorgde
            wagen en dezelfde manier van werken.
          </p>
        </article>
        <article class="belofte__punt reveal">
          <h3>Transparant</h3>
          <p>
            De prijs staat vast voor u boekt. Tol, parking en wachttijd zitten
            erin. Geen meter die verder tikt in de file, geen toeslag achteraf
            waar u niet om gevraagd hebt.
          </p>
        </article>
        <article class="belofte__punt reveal">
          <h3>Vertrouwd</h3>
          <p>
            Ervaren chauffeurs, verzekerd vervoer en wagens die onderhouden
            worden zoals het hoort. Al jaren de vaste keuze van gezinnen en
            bedrijven uit de streek.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== ZO WERKT HET ===================== -->
  <section class="werkwijze" id="werkwijze">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Zo werkt het</p>
        <h2 class="section__title">Van aanvraag tot <span class="text-accent">vertrek</span></h2>
      </div>

      {stappen.map((s) => (
        <div class="stap reveal">
          <div class="stap__nr" aria-hidden="true">{s.nr}</div>
          <h3 class="stap__titel">{s.titel}</h3>
          <p class="stap__uitleg" set:html={s.tekst}></p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== VLOOT ===================== -->
  <section class="section vloot2" id="vloot">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Onze wagens</p>
        <h2 class="section__title">Altijd een <span class="text-accent">Mercedes</span></h2>
        <p class="section__lead">
          Geen wisselend wagenpark: u rijdt in een verzorgde Mercedes met leder,
          climate control en plaats voor uw bagage.
        </p>
      </div>

      <div class="vloot2__raster">
        {wagens.map((w) => (
          <article class="wagen reveal">
            <div class="wagen__beeld">
              <Image src={w.foto} width={900} alt={`${w.naam} van Moda`} />
            </div>
            <div class="wagen__body">
              <div class="wagen__kop">
                <h3 class="wagen__naam">{w.naam}</h3>
                <span class="wagen__tag">{w.tag}</span>
              </div>
              <p class="wagen__zin">{w.zin}</p>
              <ul class="wagen__specs">
                {w.specs.map(([label, waarde]) => (
                  <li><span>{label}</span><span>{waarde}</span></li>
                ))}
              </ul>
              <a href="/vloot/" class="btn btn--ghost btn--block">Bekijk de vloot</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WAT MENSEN ZEGGEN ===================== -->
  <section class="zeg" id="zeggen">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Wat reizigers zeggen</p>
        <h2 class="section__title">Al jaren de <span class="text-accent">vaste keuze</span></h2>
      </div>

      <div class="zeg__raster">
        {citaten.map((c) => (
          <figure class="zeg__item reveal">
            <div class="zeg__sterren" aria-label="Vijf op vijf">★★★★★</div>
            <blockquote class="zeg__tekst">“{c.tekst}”</blockquote>
            <figcaption class="zeg__naam">
              {c.naam}
              <span class="zeg__plaats">{c.plaats}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="zeg__meer reveal">
        <a href="/reviews/" class="btn btn--ghost">Lees alle reviews</a>
      </div>
    </div>
  </section>

  <!-- ===================== SLOTOPROEP ===================== -->
  <section class="slot">
    <div class="container">
      <div class="slot__doos reveal">
        <h2 class="slot__titel">Wanneer moet u vertrekken?</h2>
        <p class="slot__lead">
          Geef ons uw vlucht en uw adres door, dan rekenen wij terug tot het juiste
          ophaaluur en bevestigen we uw vaste prijs.
        </p>
        <div class="slot__knoppen">
          <a href="/reserveren/" class="btn btn--primary btn--lg">Reserveer uw rit</a>
          <a href="/prijs/" class="btn btn--ghost btn--lg">Eerst de prijs zien</a>
        </div>
      </div>
    </div>
  </section>

</Luchthaven>
