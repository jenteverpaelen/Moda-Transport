    "telephone": "+3211243003",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Beringersteenweg 14",
      "postalCode": "3550",
      "addressLocality": "Heusden-Zolder",
      "addressRegion": "Limburg",
      "addressCountry": "BE"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 51.0271799, "longitude": 5.2654197 },
    "subOrganization": [
      { "@type": "TaxiService", "name": "Moda Luchthavenvervoer", "description": "Exclusief luchthavenvervoer van deur tot luchthaven." },
