---
import { Image } from "astro:assets";
import Moda from "../layouts/Moda.astro";
import instellingen from "../../public/content/settings.json";
import prijzen from "../../public/content/prices.json";
import vertrekbord from "../assets/luchthaven/vertrekbord.jpg";
import stuurNacht from "../assets/luchthaven/stuur-nacht.jpg";

/* Een dienst is een traject van A naar B. Zo staan ze hier ook. */
const trajecten = [
  {
    van: "Uw deur", naar: "De vertrekhal",
    wat: "De heenrit",
    uitleg: "Wij rekenen terug vanaf uw vluchtuur en bellen aan op het uur dat we samen vastleggen. De koffers gaan achterin, u stapt in. Twee uur voor vertrek staat u aan de balie, ook als het onderweg tegenzit — die marge zit al in de berekening.",
  },
  {
    van: "De aankomsthal", naar: "Uw deur",
    wat: "De terugrit",
    uitleg: "Wij volgen uw vluchtnummer. Landt u vroeger of later, dan schuift het ophaaluur mee. Loopt de bagageband uit, dan wachten we — daar rekenen we niets extra voor. De chauffeur staat in de hal, niet op een parking waar u hem moet zoeken.",
  },
  {
    van: "Kantoor", naar: "De gate", tussen: "Meeting",
    wat: "Zakelijk vervoer",
    uitleg: "Vaste chauffeurs, discreet, en een factuur die klopt. Voor wie regelmatig vertrekt maken we vaste afspraken, zodat u niet elke keer opnieuw hoeft door te geven waar u woont en hoe laat u weg wil.",
  },
  {
    van: "Vier deuren", naar: "Eén luchthaven",
    wat: "Groepen en families",
    uitleg: "Tot acht personen met bagage in één wagen. Vertrekt u met meer, dan rijden we met twee wagens die samen aankomen. Meerdere ophaaladressen kunnen: geef ze door bij uw aanvraag, dan plannen wij de volgorde.",
  },
];

const inbegrepen = [
  "Vaste prijs, vooraf afgesproken",
  "Vluchtopvolging bij vertraging",
  "Wachttijd in de aankomsthal",
  "Kinderzitjes, op aanvraag",
  "Hulp met de bagage",
  "Water aan boord",
];
const nietInbegrepen = [
  "Parkeerkosten bij een afwijkend adres",
  "Tolwegen buiten de gebruikelijke route",
  "Extra tussenstops die niet vooraf zijn doorgegeven",
];
---
<Moda
  titel="Diensten | Moda luchthavenvervoer"
  omschrijving="Heenrit en terugrit naar elke luchthaven, zakelijk vervoer en groepen. Vaste prijs vooraf, vluchtopvolging en eigen chauffeurs."
  actief="diensten">

  <section class="pkop">
    <div class="container">
      <h1 class="pkop__titel reus">Wij rijden maar één soort rit: de uwe.</h1>
      <div class="pkop__onder">
        <p class="lood">
          Of u nu alleen vertrekt of met acht, om drie uur 's nachts of op een
          dinsdagmiddag: het is telkens dezelfde afspraak. Eén prijs, één uur,
          één chauffeur die er staat.
        </p>
        <div class="pkop__cijfers">
          <div><span>Bestemmingen</span><span class="getal">{prijzen.luchthavens.length} luchthavens</span></div>
          <div><span>Personen per wagen</span><span class="getal">tot 8</span></div>
          <div><span>Beschikbaar</span><span class="getal">24/7</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="container">
      <div class="trajecten">
        {trajecten.map((t) => (
          <article class="traject toon">
            <div>
              <div class="traject__weg">
                <span class="traject__punt">{t.van}</span>
                <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
                {t.tussen && (<>
                  <span class="traject__punt">{t.tussen}</span>
                  <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
                </>)}
                <span class="traject__punt traject__punt--doel">{t.naar}</span>
              </div>
            </div>
            <div>
              <h2 class="traject__wat">{t.wat}</h2>
              <p class="traject__uitleg">{t.uitleg}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blok blok--asfalt">
    <div class="container">
      <div class="sectiekop toon">
        <h2 class="groot">Wat er in de prijs zit</h2>
        <p class="sectiekop__noot">En wat niet, want dat hoort er ook bij te staan.</p>
      </div>

      <div class="lijstduo toon">
        <div>
          <h3>Inbegrepen</h3>
          <ul>
            {inbegrepen.map((i) => (
              <li><svg class="ic" aria-hidden="true"><use href="#ic-vink"/></svg><span>{i}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Niet inbegrepen</h3>
          <ul class="lijstduo--nee">
            {nietInbegrepen.map((i) => (
              <li><svg class="ic" aria-hidden="true"><use href="#ic-kruis"/></svg><span>{i}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="blok">
    <div class="container detail">
      <div class="detail__beeld toon"><Image src={vertrekbord} width={900} alt="Vertrekbord in een luchthaven" /></div>
      <div class="toon">
        <h2 class="detail__naam">Wij kijken naar uw vlucht, niet naar de klok</h2>
        <p class="lood">
          Een vertraging van drie uur is voor u vervelend en voor ons gewoon een
          ander ophaaluur. Wij volgen het vluchtnummer op dat u doorgeeft en
          passen aan. U hoeft ons niet te bellen vanuit de aankomsthal.
        </p>
        <p class="klein" style="margin-top:16px">
          Er is geen automatische koppeling met een vluchtdienst: een mens kijkt
          ernaar. Dat is trager dan een computer en betrouwbaarder dan een
          computer die de verkeerde luchthaven bekijkt.
        </p>
        <div class="slot__acties" style="margin-top:26px">
          <a class="knop knop--signaal" href="/reserveren/">
            Reserveer uw rit <svg class="ic" aria-hidden="true"><use href="#ic-rechts"/></svg>
          </a>
          <a class="knop knop--stil" href="/prijs/">Bekijk de tarieven</a>
        </div>
      </div>
    </div>
  </section>

  <section class="slot">
    <div class="slot__beeld" aria-hidden="true"><Image src={stuurNacht} width={1800} alt="" /></div>
    <div class="container">
      <h2 class="reus">Vertrekt u 's nachts? Dan rijden wij 's nachts.</h2>
      <p class="slot__lead">
        De meeste ritten vertrekken tussen drie en zes uur 's ochtends. Daar
        rekenen we geen toeslag voor.
      </p>
      <div class="slot__acties">
        <a class="knop knop--signaal" href="/reserveren/">Reserveer uw rit</a>
        <a class="knop" href={`tel:${instellingen.telefoon_link}`}>
          <svg class="ic" aria-hidden="true"><use href="#ic-tel"/></svg>{instellingen.telefoon_weergave}
        </a>
      </div>
    </div>
  </section>
</Moda>
