---
import Luchthaven from "../layouts/Luchthaven.astro";
---
<Luchthaven
  titel="Onze vloot | Moda luchthavenvervoer"
  omschrijving="Comfortabele en verzorgde Mercedes-wagens met ruimte voor uw bagage."
  actief="vloot">

  <section class="section" id="vloot">
    <div class="container">
      <div class="section__head reveal">
        <p class="section__eyebrow">Onze vloot</p>
        <h2 class="section__title">Reizen in <span class="text-accent">stijl en comfort</span></h2>
        <p class="section__lead">
          Een goed onderhouden Mercedes-vloot, binnen en buiten verzorgd tot in de puntjes.
        </p>
      </div>

      <div class="gallery">
        <figure class="gallery__item gallery__item--feature reveal">
          <img src="/assets/images/fleet.jpeg" alt="De luxe Mercedes-vloot van Moda Transport voor luchthavenvervoer" />
          <figcaption>Onze Mercedes V-Klasse &amp; Vito vloot</figcaption>
        </figure>
        <figure class="gallery__item gallery__item--wide reveal">
          <img src="/assets/images/interior-seats.jpeg" alt="Luxe lederen interieur met ruime zetels" loading="lazy" />
          <figcaption>Ruim, luxe interieur</figcaption>
        </figure>
        <figure class="gallery__item reveal">
          <img src="/assets/images/interior-door.jpeg" alt="Comfortabele lederen zetels met makkelijke instap" loading="lazy" />
          <figcaption>Comfortabele instap</figcaption>
        </figure>
        <figure class="gallery__item reveal">
          <img src="/assets/images/steering-amg.jpeg" alt="Verzorgd Mercedes-AMG interieur" loading="lazy" />
          <figcaption>Verzorgd tot in het detail</figcaption>
        </figure>
      </div>
    </div>
  </section>

</Luchthaven>
